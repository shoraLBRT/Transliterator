@inherits PanelPicker

@* «О приложении» (D8): что это за страница и зачем она тому, кто пришёл впервые.
   Круглая кнопка «?» — ещё одна кнопка сбоку и ведёт себя, как ступень чтения
   и профиль (D6): одна панель на страницу, шапка с крестиком, Escape возвращает
   фокус на кнопку. Подпись рядом — вопрос «О чём проект?» (D9): по одному значку
   не понять, что за ним. Она же имя кнопки для диктора и, пока открыта колонка,
   подсказка у значка (D23) — как у соседей; title нет, чтобы подсказка не двоилась.
   Текст — короткие абзацы с подзаголовками. Чтобы он не разошёлся со страницей,
   в нём нет ничего вписанного руками, что страница знает сама: «как пишет
   страница» считает конвейер текущим профилем и ступенью, число стадий — константа
   конвейера (её сверяет тест), имена кнопок профиля — те же строки, что на кнопках. *@

<div class="picker">
    <button type="button" class="picker-toggle about-toggle" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-controls="@(IsShown ? "about-menu" : null)" @onclick="ToggleAsync" @ref="ToggleButton">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.25 9.25a2.75 2.75 0 1 1 3.9 2.5c-.7.33-1.15 1-1.15 1.78v.72" />
            <path d="M12 17.25v.01" />
        </svg>
        <span class="picker-toggle-text">@L["About.Toggle"]</span>
    </button>

    @if (IsShown)
    {
        @* Подложка листа (D14) гаснет вместе с ним; щелчок по ней закрывает лист
           и возвращает фокус на кнопку — как крестик и Escape. *@
        <div class="picker-backdrop @Closing.CssClass" @onclick="CloseToToggleAsync"></div>

        <div id="about-menu" class="picker-panel about-panel @Closing.CssClass" inert="@Closing.IsClosing" aria-hidden="@Closing.AriaHidden" role="dialog" aria-labelledby="about-menu-title"
             tabindex="-1" @ref="PanelElement" @onkeydown="OnPanelKeyDownAsync">
            <PanelHead Id="about-menu-title" Title="@L["About.Title"]" Close="CloseToToggleAsync" />

            <div class="about-body">
                <section class="about-section">
                    <h3 class="about-heading">@L["About.WhyTitle"]</h3>
                    <p>@L["About.Why"]</p>
                </section>

                <section class="about-section">
                    <h3 class="about-heading">@L["About.ExampleTitle"]</h3>
                    <p class="about-arabic" dir="rtl" lang="ar">@ExampleArabic</p>
                    <dl class="about-example">
                        <div class="about-example-row is-usual">
                            <dt>@L["About.ExampleUsual"]</dt>
                            <dd>@L["About.ExampleTypical"]</dd>
                        </div>
                        @if (Ours is { } ours)
                        {
                            <div class="about-example-row is-ours">
                                <dt>@L["About.ExampleOurs"]</dt>
                                <dd>@ours</dd>
                            </div>
                        }
                    </dl>
                    @* Буквы ح и ه в подписи — арабские отрезки с lang="ar" (D25). *@
                    <p><MixedText Text="@L["About.ExampleNote"]" /></p>
                </section>

                @* Остальные разделы свёрнуты (D26): лид и пример читаются сразу, подробности — по нажатию. *@
                @Folded("how", "About.HowTitle", HowBody)
                @Folded("profiles", "About.ProfilesTitle", ProfilesBody)
                @Folded("thanks", "About.ThanksTitle", ThanksBody)
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Пример на двух словах: в привычной записи ح и ه сливаются в одну «х»,
    /// а долгий гласный не виден — у страницы это разные буквы.
    /// </summary>
    public const string ExampleArabic = "ٱلْحَمْدُ لِلَّهِ";

    /// <summary>
    /// Транслитерация текущим профилем и ступенью страницы — та же, что у примеров
    /// правил. Без неё — или когда она вернула <c>null</c> — строки «как пишет
    /// страница» нет: вписанный руками вывод разошёлся бы с настоящим.
    /// </summary>
    [Parameter]
    public Func<string, string?>? Transliterate { get; set; }

    /// <summary>Открыть форму отзыва (H1, H3) — она у подвала страницы.</summary>
    [Parameter]
    public EventCallback OpenFeedback { get; set; }

    protected override string Panel => "about";

    /// <summary>Раскрытые разделы (D26). При открытии панели все свёрнуты.</summary>
    private readonly HashSet<string> _openSections = new();

    protected override Task BeforeOpenAsync()
    {
        _openSections.Clear();
        return Task.CompletedTask;
    }

    private void ToggleSection(string id)
    {
        if (!_openSections.Remove(id))
            _openSections.Add(id);
    }

    /// <summary>
    /// Раздел с заголовком-кнопкой и свёрнутым телом (D26): тот же приём `.fold`,
    /// что у блоков правил, — свёрнутое тело inert и aria-hidden.
    /// </summary>
    private RenderFragment Folded(string id, string titleKey, RenderFragment body) => __builder =>
    {
        var open = _openSections.Contains(id);
        var bodyId = $"about-fold-{id}";
        <section class="about-section">
            <h3 class="about-heading">
                <button type="button" class="about-fold-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="@bodyId"
                        @onclick="() => ToggleSection(id)">
                    <span>@L[titleKey]</span>
                    <svg class="about-fold-chevron" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" />
                    </svg>
                </button>
            </h3>
            <div id="@bodyId" class="fold @(open ? "is-open" : null)" inert="@(!open)" aria-hidden="@(open ? null : "true")">
                <div class="fold-inner">@body</div>
            </div>
        </section>
    };

    private RenderFragment HowBody => @<p>@L["About.How", L.Count("StageCount", TransliterationService.StageCount)]</p>;

    private RenderFragment ProfilesBody => @<p>@L["About.Profiles", L["Profile.Create"].Value, L["Profile.Settings"].Value]</p>;

    private RenderFragment ThanksBody => @<text>
        <p>@L["About.Thanks"]</p>
        <button type="button" class="about-feedback" @onclick="OpenFeedbackAsync">@L["About.FeedbackAction"]</button>
    </text>;

    private string? Ours => Transliterate?.Invoke(ExampleArabic);

    /// <summary>
    /// Панель закрывается, и фокус уходит в поле отзыва: форма открывается своей
    /// кнопкой у подвала, рядом с ней же и закрывается.
    /// </summary>
    private async Task OpenFeedbackAsync()
    {
        Close();
        await OpenFeedback.InvokeAsync();
    }
}

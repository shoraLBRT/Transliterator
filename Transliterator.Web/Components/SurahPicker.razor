@inherits PanelPicker

@* Готовые суры одной кнопкой под полем ввода — единственная настройка, что
   осталась под полем (D6): сура меняет сам текст, а не то, как он пишется.
   Список открывается так же, как панели ступени и профиля: на широком экране
   колонкой сбоку. Список не перечисляет суры в разметке: сура, добавленная
   в корпус, появляется здесь сама. *@

<div class="picker">
    <button type="button" class="picker-toggle" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-controls="surah-menu" @onclick="ToggleAsync" @ref="ToggleButton">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5.5C5.5 4.2 8.5 4.2 12 6c3.5-1.8 6.5-1.8 9-.5V19c-2.5-1.3-5.5-1.3-9 .5-3.5-1.8-6.5-1.8-9-.5z" />
            <path d="M12 6v13.5" />
        </svg>
        <span>Выбрать суру</span>
    </button>

    @if (IsOpen)
    {
        <div class="picker-backdrop" @onclick="Close"></div>

        <div id="surah-menu" class="picker-panel" role="dialog" aria-labelledby="surah-menu-title"
             tabindex="-1" @ref="PanelElement" @onkeydown="OnPanelKeyDownAsync">
            <PanelHead Id="surah-menu-title" Title="Готовые суры" Close="CloseToToggleAsync" />
            <p class="picker-caption">Транслитерация этих сур сверена вручную</p>

            <ul class="picker-list">
                @foreach (var surah in Surahs)
                {
                    <li>
                        <button type="button" class="picker-item" @onclick="() => ChooseAsync(surah)">
                            <span class="picker-number">@surah.Number</span>
                            <span class="picker-name">@surah.RussianName</span>
                            <span class="picker-arabic" dir="rtl" lang="ar">@surah.ArabicName</span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CorpusSurah> Surahs { get; set; } = Array.Empty<CorpusSurah>();

    [Parameter]
    public EventCallback<CorpusSurah> Chosen { get; set; }

    protected override string Panel => "surah";

    /// <summary>Сура выбрана — список закрывается: текст в поле уже другой, и вывод рядом.</summary>
    private async Task ChooseAsync(CorpusSurah surah)
    {
        Close();
        await Chosen.InvokeAsync(surah);
    }
}

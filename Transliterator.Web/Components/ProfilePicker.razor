@using System.Globalization
@using Transliterator.Core.Repositories
@using Transliterator.Core.Services
@using Transliterator.Domain.Exceptions
@inject UserProfileRepository Profiles
@inject ProfileEditor Editor
@inject ICorpusRepository Corpus
@inject ITransliterationService Transliteration
@inject ILogger<ProfilePicker> Logger
@inherits PanelPicker

@* Свои профили (E4). Как ступени чтения — одна круглая кнопка сбоку страницы (D6):
   профили не на виду, пока их не открыли (D5). Внутри — выбор профиля, создание
   своего из выбранного (E9), переименование и удаление своего, и графемы с поиском. На телефоне панель
   закрывает результат, поэтому вывод повторён в ней самой: правка графемы видна
   сразу. На широком экране панель стоит колонкой рядом с выводом, и повтор
   там скрыт стилями.
   Спорная графема своего профиля помечена прямо у буквы, с примером (E5):
   запрещать её не нужно — решает пользователь, — но видеть, к чему она
   приведёт, он должен.
   У кнопки — подпись и имя («Профиль: Standard», свой — «Профиль: Мой», E6):
   одно имя не говорит пришедшему впервые, что кнопка выбирает. Подпись — часть
   текста кнопки, а не оформление вокруг неё: она же имя кнопки для экранного
   диктора и стоит рядом с круглым значком (D6). Длинное имя обрезается
   многоточием с конца, и подпись остаётся видна. *@

<div class="picker">
    <button type="button" class="picker-toggle" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-controls="profile-menu" title="@ToggleText" @onclick="ToggleAsync" @ref="ToggleButton">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z" />
            <path d="M14 8l2.5 2.5" />
        </svg>
        <span class="picker-toggle-text">@ToggleText</span>
    </button>

    @if (IsOpen)
    {
        <div class="picker-backdrop" @onclick="Close"></div>

        <div id="profile-menu" class="picker-panel profile-panel" role="dialog" aria-labelledby="profile-menu-title"
             tabindex="-1" @ref="PanelElement" @onkeydown="OnPanelKeyDownAsync">
            <PanelHead Id="profile-menu-title" Title="@L["Profile.Title"]" Close="CloseToToggleAsync" />
            <p class="picker-caption">@L["Profile.Caption"]</p>

            <div class="reading-modes" role="radiogroup" aria-label="@L["Profile.ListLabel"]">
                @foreach (var item in _profiles)
                {
                    <button type="button" class="reading-mode" role="radio"
                            aria-checked="@(item.Name == Profile.Name ? "true" : "false")"
                            @onclick="() => SelectAsync(item.Name)">
                        <span class="reading-mode-name">@item.Name</span>
                        <span class="reading-mode-note">@(item.BuiltIn ? L["Profile.BuiltIn"] : L["Profile.Own"])</span>
                    </button>
                }
            </div>

            <div class="profile-actions">
                @switch (_mode)
                {
                    case Mode.Rename:
                        <form class="profile-name-form" @onsubmit="RenameAsync" @onsubmit:preventDefault>
                            <label for="profile-name" class="visually-hidden">@L["Profile.NewNameLabel"]</label>
                            <input id="profile-name" class="profile-input" autocomplete="off" spellcheck="false"
                                   @bind="_name" @bind:event="oninput" @bind:after="CheckNameAsync" @ref="_nameInput" />
                            <button type="submit" class="profile-button is-primary" disabled="@(_nameProblem is not null)">@L["Profile.Done"]</button>
                            <button type="button" class="profile-button" @onclick="Cancel">@L["Profile.Cancel"]</button>
                        </form>

                        @if (_nameProblem is not null)
                        {
                            <p class="profile-note is-error" role="alert">@_nameProblem</p>
                        }
                        break;

                    case Mode.Delete:
                        <p class="profile-note">@L["Profile.DeleteConfirm", Profile.Name]</p>
                        <div class="profile-buttons">
                            <button type="button" class="profile-button is-danger" @onclick="DeleteAsync">@L["Profile.Delete"]</button>
                            <button type="button" class="profile-button" @onclick="Cancel">@L["Profile.Cancel"]</button>
                        </div>
                        break;

                    default:
                        <div class="profile-buttons">
                            <button type="button" class="profile-button is-primary" @onclick="CreateAsync">@L["Profile.Create"]</button>
                            @if (!IsBuiltIn)
                            {
                                <button type="button" class="profile-button" @onclick="StartRenameAsync">@L["Profile.Rename"]</button>
                                <button type="button" class="profile-button is-danger" @onclick="StartDelete">@L["Profile.Delete"]</button>
                            }
                        </div>
                        break;
                }

                @if (_error is not null)
                {
                    <p class="profile-note is-error" role="alert">@_error</p>
                }

                @if (ShownConflicts.Count > 0)
                {
                    <p class="profile-note is-warning" role="status">@L["Profile.Conflicts", ShownConflicts.Count]</p>
                }
            </div>

            <div class="profile-preview" aria-live="polite">
                <span class="profile-preview-label">@L["Profile.PreviewLabel"]</span>
                <span class="profile-preview-text">@(string.IsNullOrEmpty(Preview) ? L["Profile.PreviewEmpty"] : Preview)</span>
            </div>

            @* Графемы — под стрелкой «Настройки профиля» (E9): профиль выбирают чаще,
               чем переписывают. При открытии панели блок свёрнут, у только что
               созданного профиля — раскрыт: его создают, чтобы переписать графемы. *@
            <section class="profile-settings">
                <h3 class="profile-settings-head">
                    <button type="button" class="profile-settings-toggle"
                            aria-expanded="@(_settingsOpen ? "true" : "false")" aria-controls="profile-settings"
                            @onclick="ToggleSettings">
                        <span class="profile-settings-name">@L["Profile.Settings"]</span>
                        <svg class="profile-settings-chevron" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 9l6 6 6-6" />
                        </svg>
                    </button>
                </h3>

                <div id="profile-settings" class="profile-rules" hidden="@(!_settingsOpen)">
                    @if (_settingsOpen)
                    {
                        <input type="search" class="profile-input profile-search" aria-label="@L["Profile.SearchLabel"]"
                               placeholder="@L["Profile.SearchPlaceholder"]" spellcheck="false" autocomplete="off"
                               @bind="_query" @bind:event="oninput" />

                        var groups = RuleTable.Filter(_groups, _query);

                        if (groups.Count == 0)
                        {
                            <p class="profile-note">@L["Profile.NoMatches"]</p>
                        }
                        else
                        {
                            @* Таблица, а не список строк (E9): у столбцов одна ширина во всех
                               строках, у ячеек — границы. Буква стоит одной ячейкой на все свои
                               строки, её основная графема — крупно, варианты — мельче и тише. *@
                            <table class="profile-table">
                                <colgroup>
                                    <col class="profile-col-letter" />
                                    <col class="profile-col-variant" />
                                    <col class="profile-col-value" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Profile.LetterColumn"]</th>
                                        <th scope="col">@L["Profile.VariantColumn"]</th>
                                        <th scope="col">@L["Profile.ValueColumn"]</th>
                                    </tr>
                                </thead>

                                @foreach (var group in groups)
                                {
                                    var warnings = ShownConflicts.Where(c => c.Involves(group.BaseKey)).ToList();

                                    <tbody class="profile-group">
                                        <tr class="profile-row">
                                            <th scope="rowgroup" rowspan="@(1 + warnings.Count + group.Variants.Count)" class="profile-key"
                                                dir="rtl" lang="ar" title="@CodePoints(group.BaseKey)">@Display(group.BaseKey)</th>
                                            <td class="profile-variant-cell"></td>
                                            <td class="profile-value-cell">@Cell(group.BaseKey)</td>
                                        </tr>

                                        @foreach (var conflict in warnings)
                                        {
                                            <tr class="profile-warning-row">
                                                <td colspan="2">@Warning(conflict)</td>
                                            </tr>
                                        }

                                        @foreach (var variant in group.Variants)
                                        {
                                            <tr class="profile-row is-variant">
                                                <td class="profile-variant-cell">
                                                    <code class="profile-variant" title="@variant.Key">@variant.Name</code>
                                                    @if (variant.Note is not null)
                                                    {
                                                        <span class="profile-variant-note">@variant.Note</span>
                                                    }
                                                </td>
                                                <td class="profile-value-cell">@Cell(variant.Key)</td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                            </table>
                        }
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    /// <summary>Профиль, которым пишет страница.</summary>
    [Parameter, EditorRequired]
    public TransliterationProfile Profile { get; set; } = default!;

    /// <summary>Текст кнопки сбоку: что она выбирает и что выбрано (E6).</summary>
    private string ToggleText => L["Profile.Toggle", Profile.Name];

    /// <summary>
    /// Профиль по умолчанию: стоит в списке первым, и к нему страница возвращается,
    /// когда выбранный профиль удалён.
    /// </summary>
    [Parameter, EditorRequired]
    public string DefaultProfile { get; set; } = string.Empty;

    /// <summary>Вывод страницы: на телефоне панель закрывает результат и повторяет его в себе.</summary>
    [Parameter]
    public string Preview { get; set; } = string.Empty;

    /// <summary>
    /// Выбран другой профиль или изменён этот. Страница пересчитывает вывод
    /// и запоминает выбор.
    /// </summary>
    [Parameter]
    public EventCallback<TransliterationProfile> ProfileChanged { get; set; }

    /// <summary>
    /// Свой профиль удалён. Страница возвращается к профилю по умолчанию и забывает
    /// выбор: к профилю по умолчанию её вернуло удаление, а не человек (D7).
    /// </summary>
    [Parameter]
    public EventCallback ProfileDeleted { get; set; }

    private enum Mode { None, Rename, Delete }

    private sealed record Item(string Name, bool BuiltIn);

    protected override string Panel => "profile";

    private bool _focusName;
    private ElementReference _nameInput;

    private IReadOnlyList<Item> _profiles = Array.Empty<Item>();
    private Mode _mode;
    private string _name = string.Empty;
    private string? _nameProblem;
    private string? _error;
    private string _query = string.Empty;

    /// <summary>Раскрыты ли «Настройки профиля» — поиск и таблица графем (E9).</summary>
    private bool _settingsOpen;

    private TransliterationProfile? _grouped;
    private IReadOnlyList<RuleGroup> _groups = Array.Empty<RuleGroup>();

    private IReadOnlyList<GraphemeConflict> _conflicts = Array.Empty<GraphemeConflict>();

    /// <summary>Текст корпуса — источник примеров к спорам. Читается при первом открытии.</summary>
    private IReadOnlyList<string>? _texts;

    /// <summary>
    /// Споры показываются у своего профиля: встроенный не правится, и его споры —
    /// решения владельца (G2), а не то, что пользователь только что ввёл.
    /// </summary>
    private IReadOnlyList<GraphemeConflict> ShownConflicts =>
        IsBuiltIn ? Array.Empty<GraphemeConflict>() : _conflicts;

    private bool IsBuiltIn => _profiles.FirstOrDefault(p => p.Name == Profile.Name)?.BuiltIn ?? true;

    // Группы пересобираются при смене профиля, а не на каждую отрисовку: страница
    // перерисовывается на каждую правку текста. Значения берутся из словаря
    // профиля в момент отрисовки — правка графемы групп не меняет.
    protected override void OnParametersSet()
    {
        // Споры же считаются заново всегда: правка графемы меняет словарь на месте,
        // и профиль остаётся тем же объектом. Букв три десятка — это дёшево.
        _conflicts = GraphemeConflicts.Find(Profile.Rules);

        if (ReferenceEquals(_grouped, Profile))
            return;

        _grouped = Profile;
        _groups = RuleTable.Group(Profile.Rules);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_focusName)
        {
            _focusName = false;
            await _nameInput.FocusAsync();
        }
    }

    protected override Task BeforeOpenAsync() => LoadProfilesAsync();

    /// <summary>
    /// Закрытие — любым путём, в том числе другой панелью, — сбрасывает начатое
    /// переименование или удаление, но не теряет правки: каждая графема сохраняется сразу.
    /// </summary>
    protected override void OnClosed()
    {
        Cancel();
        _settingsOpen = false;
    }

    private void ToggleSettings() => _settingsOpen = !_settingsOpen;

    private async Task LoadProfilesAsync()
    {
        try
        {
            var all = await Profiles.GetAllProfilesAsync();
            var items = new List<Item>();

            foreach (var profile in all)
                items.Add(new Item(profile.Name, await Profiles.IsBuiltInAsync(profile.Name)));

            // Профиль по умолчанию — первым, за ним прочие встроенные, потом свои.
            _texts ??= await LoadTextsAsync();

            _profiles = items.OrderByDescending(p => p.Name == DefaultProfile)
                             .ThenByDescending(p => p.BuiltIn)
                             .ToList();

            foreach (var problem in Profiles.Problems)
                Logger.LogWarning("Stored profile skipped: {Problem}", problem);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Profiles could not be listed");
            _error = L["Profile.ListError"];
        }
    }

    private async Task SelectAsync(string name)
    {
        if (name == Profile.Name)
            return;

        Cancel();

        if (await Profiles.GetProfileAsync(name) is { } profile)
            await ProfileChanged.InvokeAsync(profile);
        else
            _error = L["Profile.NotRead", name];
    }

    /// <summary>
    /// Свой профиль создаётся одним нажатием из выбранного — встроенного или своего (E9), —
    /// под свободным именем, и сразу выбирается: имя можно сменить потом, а графемы
    /// править — сразу, поэтому «Настройки профиля» у него раскрыты.
    /// </summary>
    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            var name = await Editor.SuggestCopyNameAsync(Profile.Name);
            var copy = await Editor.CreateCopyAsync(Profile.Name, name);

            await LoadProfilesAsync();
            _settingsOpen = true;
            await ProfileChanged.InvokeAsync(copy);
        });
    }

    private async Task StartRenameAsync()
    {
        Cancel();
        _mode = Mode.Rename;
        _name = Profile.Name;
        _focusName = true;
        await CheckNameAsync();
    }

    private async Task CheckNameAsync() => _nameProblem = await Editor.CheckNameAsync(_name, renaming: Profile.Name);

    private async Task RenameAsync()
    {
        await RunAsync(async () =>
        {
            var renamed = await Editor.RenameAsync(Profile.Name, _name);

            _mode = Mode.None;
            await LoadProfilesAsync();
            await ProfileChanged.InvokeAsync(renamed);
        });
    }

    private void StartDelete()
    {
        Cancel();
        _mode = Mode.Delete;
    }

    /// <summary>Удалённый профиль больше писать не может — страница возвращается к профилю по умолчанию.</summary>
    private async Task DeleteAsync()
    {
        await RunAsync(async () =>
        {
            await Editor.DeleteAsync(Profile.Name);

            _mode = Mode.None;
            await LoadProfilesAsync();

            await ProfileDeleted.InvokeAsync();
        });
    }

    private void Cancel()
    {
        _mode = Mode.None;
        _nameProblem = null;
        _error = null;
    }

    /// <summary>
    /// Графема пишется в профиль и сохраняется на каждую правку. Не сохранилась —
    /// правка всё равно видна на тексте, а под кнопками сказано, что после
    /// перезагрузки её не будет.
    /// </summary>
    private async Task SetRuleAsync(string key, string value)
    {
        await RunAsync(() => Editor.SetRuleAsync(Profile, key, value));
        await ProfileChanged.InvokeAsync(Profile);
    }

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;

        try
        {
            await action();
        }
        catch (TransliterationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            // Необработанное исключение в WebAssembly гасит страницу целиком.
            Logger.LogError(ex, "Profile action failed");
            _error = L["Profile.Failed"];
        }
    }

    /// <summary>Не прочитался корпус — споры всё равно видны, только без примеров.</summary>
    private async Task<IReadOnlyList<string>> LoadTextsAsync()
    {
        try
        {
            return (await Corpus.GetAllSurahsAsync())
                .SelectMany(surah => surah.Ayahs.Select(ayah => ayah.Arabic))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Corpus could not be read for conflict examples");
            return Array.Empty<string>();
        }
    }

    /// <summary>
    /// Предупреждение у буквы: что с чем спорит и пример — слово из корпуса
    /// и его вывод этим профилем, где спорная графема видна.
    /// </summary>
    private RenderFragment Warning(GraphemeConflict conflict)
    {
        var letter = conflict.Letter;
        var first = conflict.Parts[0];

        // Пример — к спорящей букве, а при совпадении — к обеим: видно, что пишутся одинаково.
        var examples = (conflict.IsComposed ? new[] { letter } : conflict.Letters.ToArray())
            .Select(Example)
            .OfType<(string Arabic, string Output)>()
            .ToList();

        // Арабская буква внутри фразы — в bdi: иначе алгоритм двунаправленного текста
        // утаскивает за ней соседнюю пунктуацию. Фраза — из ресурсов (D7), и буквы
        // и графемы подставляются в неё уже экранированными: графема своего профиля —
        // ввод пользователя.
        var text = conflict.IsComposed
            ? L["Conflict.Composed", Encode(Grapheme(letter)), Arabic(letter), Encode(Grapheme(first)), Arabic(first),
                Encode(Grapheme(conflict.Parts[1])), Arabic(conflict.Parts[1])].Value
            : L["Conflict.Same", Encode(Grapheme(letter)), Arabic(first), Arabic(letter)].Value;

        return @<p class="profile-warning" role="status">
                    <span>@((MarkupString)text)</span>
                    @foreach (var (arabic, output) in examples)
                    {
                        <span class="profile-example">
                            <span dir="rtl" lang="ar">@arabic</span> → <span>@output</span>
                        </span>
                    }
                </p>;
    }

    private string Grapheme(string letter) => Profile.Rules.GetValueOrDefault(letter) ?? string.Empty;

    private static string Encode(string text) => System.Net.WebUtility.HtmlEncode(text);

    private static string Arabic(string letter) => $"<bdi lang=\"ar\">{Encode(letter)}</bdi>";

    /// <summary>Слово из корпуса с этой буквой и его вывод текущим профилем.</summary>
    private (string Arabic, string Output)? Example(string letter)
    {
        if (_texts is null || GraphemeConflicts.ExampleWord(_texts, letter) is not { } word)
            return null;

        try
        {
            return (word, Transliteration.Transliterate(word, Profile).TransliteratedText);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Conflict example could not be transliterated");
            return null;
        }
    }

    /// <summary>
    /// Огласовка без буквы не видна: её рисуют над пунктирным кружком — так
    /// диакритику принято показывать отдельно от текста.
    /// </summary>
    private static string Display(string key) =>
        key.Length > 0 && CharUnicodeInfo.GetUnicodeCategory(key[0]) == UnicodeCategory.NonSpacingMark
            ? "◌" + key
            : key;

    private static string CodePoints(string key) =>
        string.Join(" ", key.Select(c => $"U+{(int)c:X4}"));

    /// <summary>
    /// Графема ключа: полем у своего профиля, текстом у встроенного. Незаданный
    /// базовый ключ полем не становится — ключи добавляет не таблица.
    /// Пустая графема — решение профиля (отзвук кальканя, начальная хамза),
    /// и выглядеть пропуском она не должна.
    /// </summary>
    private RenderFragment Cell(string key)
    {
        var value = Profile.Rules.TryGetValue(key, out var found) ? found : null;

        if (IsBuiltIn || value is null)
            return value switch
            {
                null => @<span class="profile-value is-missing">@L["Profile.ValueMissing"]</span>,
                "" => @<span class="profile-value is-empty">@L["Profile.ValueEmpty"]</span>,
                _ => @<span class="profile-value">@value</span>
            };

        return @<input class="profile-input profile-value-input" value="@value" aria-label="@(L["Profile.ValueLabel", key])"
                       placeholder="@L["Profile.ValueEmpty"]" spellcheck="false" autocomplete="off"
                       @oninput="e => SetRuleAsync(key, e.Value?.ToString() ?? string.Empty)" />;
    }
}

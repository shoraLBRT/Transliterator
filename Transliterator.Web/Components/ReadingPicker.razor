@using Transliterator.Core.Services
@inherits PanelPicker

@* Ступени чтения (I2): полный таджвид, неполный таджвид (I5), обычное чтение.
   Одна круглая кнопка сбоку страницы (D6): ступени не загромождают поле (D5),
   а панель на широком экране открывается колонкой рядом с полем и выводом.
   Рядом с кнопкой — имя выбранной ступени: оно же текст кнопки и её имя для
   экранного диктора. Правила и их описания берутся из каталога (I1) — правило,
   добавленное в каталог, появляется здесь само. Рядом с названием правила
   в скобках — его перевод (I7): «Мадд лязим» без него — арабское слово
   русскими буквами. В «Неполном таджвиде» у правил со счётом — выбор счёта, а у правил,
   которые можно не читать (I4), — переключатель: какие именно, решает каталог
   (Counts, Switchable). *@

<div class="picker">
    @* Значок — звуковая волна: кнопка выбирает, как текст звучит. *@
    <button type="button" class="picker-toggle" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-controls="reading-menu" title="@ModeName(Choice.Mode)" @onclick="ToggleAsync" @ref="ToggleButton">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2" />
        </svg>
        <span class="picker-toggle-text">@ModeName(Choice.Mode)</span>
    </button>

    @if (IsOpen)
    {
        <div class="picker-backdrop" @onclick="Close"></div>

        <div id="reading-menu" class="picker-panel reading-panel" role="dialog" aria-labelledby="reading-menu-title"
             tabindex="-1" @ref="PanelElement" @onkeydown="OnPanelKeyDownAsync">
            <PanelHead Id="reading-menu-title" Title="@L["Reading.Title"]" Close="CloseToToggleAsync" />

            <div class="reading-modes" role="radiogroup" aria-label="@L["Reading.ModesLabel"]">
                @foreach (var mode in Modes)
                {
                    <button type="button" class="reading-mode" role="radio"
                            aria-checked="@(Choice.Mode == mode ? "true" : "false")"
                            @onclick="() => ChooseModeAsync(mode)">
                        <span class="reading-mode-name">@ModeName(mode)</span>
                        <span class="reading-mode-note">@ModeNote(mode)</span>
                    </button>
                }
            </div>

            @* Под ступенями — два блока правил (I8): сначала правила чтения на арабском,
               потом правила таджвида, как в группах I6. Оба свёрнуты, пока их не откроют;
               в заголовке видно, сколько в блоке правил и читаются ли они сейчас — и у
               свёрнутого. Счёт и переключатель «Неполного таджвида» стоят в строке
               своего правила (I3, I4), отдельного списка нет. *@
            @foreach (var group in Groups)
            {
                var tier = group.Key;
                var off = IsOff(tier);
                var open = _openBlocks.Contains(tier);
                var blockId = BlockId(tier);

                <section class="reading-block">
                    <h3 class="reading-group @(off ? "is-off" : null)">
                        <button type="button" class="reading-group-toggle"
                                aria-expanded="@(open ? "true" : "false")" aria-controls="@blockId"
                                @onclick="() => ToggleBlock(tier)">
                            <span class="reading-group-name">@GroupName(tier)</span>
                            <span class="reading-group-count">@L.Count("RuleCount", group.Count())@(off ? L["Reading.GroupOff"].Value : null)</span>
                            <svg class="reading-group-chevron" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 9l6 6 6-6" />
                            </svg>
                        </button>
                    </h3>

                    <div id="@blockId" class="reading-block-body" hidden="@(!open)">
                        @if (Variants && tier == TajweedTier.Tajweed)
                        {
                            <p class="reading-variants-note">@L["Reading.CountsNote"]</p>
                            <p class="reading-variants-note">@L["Reading.SwitchableNote"]</p>
                        }

                        <ul class="reading-list">
                            @foreach (var rule in group)
                            {
                                var example = rule.Examples.FirstOrDefault();
                                var counts = Variants && rule.HasVariants;
                                var switchable = Variants && rule.Switchable;
                                var on = Choice.Reads(rule);

                                <li class="reading-rule @(IsOff(rule) ? "is-off" : null)">
                                    <span class="reading-rule-head">
                                        <span class="reading-rule-title">
                                            <span class="reading-rule-name">@rule.Name.Current</span>
                                            <span class="reading-rule-translation">(@rule.Translation.Current)</span>
                                        </span>
                                        <span class="reading-rule-arabic" dir="rtl" lang="ar">@rule.ArabicName</span>
                                    </span>
                                    @if (counts || switchable)
                                    {
                                        <span class="reading-rule-controls">
                                            @if (counts)
                                            {
                                                <span class="reading-counts" role="radiogroup" aria-label="@(L["Reading.CountLabel", rule.Name.Current])">
                                                    @foreach (var count in rule.Counts)
                                                    {
                                                        <button type="button" class="reading-count" role="radio"
                                                                aria-checked="@(Choice.CountOf(rule) == count ? "true" : "false")"
                                                                @onclick="() => ChooseCountAsync(rule, count)">@count</button>
                                                    }
                                                </span>
                                            }
                                            @if (switchable)
                                            {
                                                <button type="button" class="reading-switch" role="switch"
                                                        aria-checked="@(on ? "true" : "false")"
                                                        aria-label="@(L["Reading.SwitchLabel", rule.Name.Current])"
                                                        @onclick="() => SwitchRuleAsync(rule, !on)">
                                                    <span class="reading-switch-track" aria-hidden="true"></span>
                                                    <span class="reading-switch-text">@(on ? L["Reading.On"] : L["Reading.Off"])</span>
                                                </button>
                                            }
                                            @if (example is not null)
                                            {
                                                <span class="reading-example">
                                                    <span class="reading-rule-arabic" dir="rtl" lang="ar">@example.Arabic</span>
                                                    <span class="reading-example-arrow" aria-hidden="true">→</span>
                                                    <span class="reading-example-text" aria-live="polite">@ExampleOf(example)</span>
                                                </span>
                                            }
                                        </span>
                                    }
                                    <span class="reading-rule-text">@rule.Description.Current</span>
                                </li>
                            }
                        </ul>
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TajweedRuleCatalog Catalog { get; set; } = new();

    [Parameter, EditorRequired]
    public ReadingChoice Choice { get; set; } = ReadingChoice.Default;

    [Parameter]
    public EventCallback<ReadingChoice> ChoiceChanged { get; set; }

    /// <summary>
    /// Транслитерация текущим выбором и профилем страницы. Пример правила в «Неполном
    /// таджвиде» пересчитывается под выбранный счёт — так видно, что счёт меняет (I3).
    /// Без неё — или когда она вернула <c>null</c> — показывается пример из каталога,
    /// посчитанный полным таджвидом.
    /// </summary>
    [Parameter]
    public Func<string, string?>? Transliterate { get; set; }

    private static readonly ReadingMode[] Modes = { ReadingMode.Full, ReadingMode.Variants, ReadingMode.Plain };

    protected override string Panel => "reading";

    /// <summary>Раскрытые блоки правил (I8). При открытии панели оба свёрнуты.</summary>
    private readonly HashSet<TajweedTier> _openBlocks = new();

    private bool Variants => Choice.Mode == ReadingMode.Variants;

    protected override Task BeforeOpenAsync()
    {
        _openBlocks.Clear();
        return Task.CompletedTask;
    }

    private void ToggleBlock(TajweedTier tier)
    {
        if (!_openBlocks.Remove(tier))
            _openBlocks.Add(tier);
    }

    private static string BlockId(TajweedTier tier) => $"reading-rules-{tier.ToString().ToLowerInvariant()}";

    /// <summary>
    /// Сначала правила чтения на арабском, потом правила таджвида (I6, I8). Заголовок
    /// блока прилипает к верху панели, пока блок прокручивается: видно, к какому блоку
    /// относится правило перед глазами.
    /// </summary>
    private IEnumerable<IGrouping<TajweedTier, TajweedRule>> Groups =>
        Catalog.Rules.GroupBy(r => r.Tier).OrderBy(g => g.Key);

    /// <summary>
    /// В обычном чтении правила таджвида не читаются — они видны, но погашены.
    /// В «Неполном таджвиде» погашены и правила, выключенные по одному (I4).
    /// </summary>
    private bool IsOff(TajweedRule rule) =>
        IsOff(rule.Tier) || (Choice.Mode == ReadingMode.Variants && rule.Switchable && !Choice.Reads(rule));

    private bool IsOff(TajweedTier tier) =>
        Choice.Mode == ReadingMode.Plain && tier == TajweedTier.Tajweed;

    private string ExampleOf(TajweedRuleExample example) =>
        Transliterate?.Invoke(example.Arabic) ?? example.Transliteration;

    private string ModeName(ReadingMode mode) => mode switch
    {
        ReadingMode.Variants => L["Mode.Variants"],
        ReadingMode.Plain => L["Mode.Plain"],
        _ => L["Mode.Full"],
    };

    private string ModeNote(ReadingMode mode) => mode switch
    {
        ReadingMode.Variants => L["ModeNote.Variants"],
        ReadingMode.Plain => L["ModeNote.Plain"],
        _ => L["ModeNote.Full"],
    };

    private string GroupName(TajweedTier tier) => tier switch
    {
        TajweedTier.Tajweed => L["Group.Tajweed"],
        _ => L["Group.Base"],
    };

    /// <summary>
    /// Выбранная ступень сразу видна в выводе, и панель закрывается: на телефоне —
    /// чтобы его открыть, на широком экране — потому что выбор сделан, как и у сур.
    /// «Неполный таджвид» оставляет её открытой и раскрывает «Правила таджвида» (I8):
    /// счёты и переключатели выбираются здесь же, в строках правил.
    /// </summary>
    private async Task ChooseModeAsync(ReadingMode mode)
    {
        if (mode == ReadingMode.Variants)
            _openBlocks.Add(TajweedTier.Tajweed);
        else
            Close();

        await ChoiceChanged.InvokeAsync(Choice.WithMode(mode));
    }

    private Task ChooseCountAsync(TajweedRule rule, int count) =>
        ChoiceChanged.InvokeAsync(Choice.WithCount(rule.Id, count));

    private Task SwitchRuleAsync(TajweedRule rule, bool on) =>
        ChoiceChanged.InvokeAsync(Choice.WithRule(rule.Id, on));
}

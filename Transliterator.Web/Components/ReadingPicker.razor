@using Transliterator.Core.Services
@inherits PanelPicker

@* Ступени чтения (I2): полный таджвид, неполный таджвид (I5), обычное чтение.
   Одна круглая кнопка сбоку страницы (D6): ступени не загромождают поле (D5),
   а панель на широком экране открывается колонкой рядом с полем и выводом.
   Рядом с кнопкой — имя выбранной ступени: оно же текст кнопки и её имя для
   экранного диктора. Правила и их описания берутся из каталога (I1) — правило,
   добавленное в каталог, появляется здесь само. Рядом с названием правила
   в скобках — его перевод (I7): «Мадд лязим» без него — арабское слово
   русскими буквами. В «Неполном таджвиде» у правил со счётом — выбор счёта, а у правил,
   которые можно не читать (I4), — переключатель: какие именно, решает каталог
   (Counts, Switchable). *@

<div class="picker">
    @* Значок — звуковая волна: кнопка выбирает, как текст звучит. *@
    <button type="button" class="picker-toggle" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-controls="reading-menu" @onclick="ToggleAsync" @ref="ToggleButton">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2" />
        </svg>
        <span class="picker-toggle-text">@ModeName(Choice.Mode)</span>
    </button>

    @if (IsShown)
    {
        @* Подложка листа (D14) гаснет вместе с ним; щелчок по ней закрывает лист
           и возвращает фокус на кнопку — как крестик и Escape. *@
        <div class="picker-backdrop @Closing.CssClass" @onclick="CloseToToggleAsync"></div>

        <div id="reading-menu" class="picker-panel reading-panel @Closing.CssClass" inert="@Closing.IsClosing" aria-hidden="@Closing.AriaHidden" role="dialog" aria-labelledby="reading-menu-title"
             tabindex="-1" @ref="PanelElement" @onkeydown="OnPanelKeyDownAsync">
            <PanelHead Id="reading-menu-title" Title="@L["Reading.Title"]" Close="CloseToToggleAsync"
                       Note="@(Unchanged ? L["Output.Unchanged"].Value : null)" />

            <div class="reading-modes" role="radiogroup" aria-label="@L["Reading.ModesLabel"]">
                @foreach (var mode in Modes)
                {
                    <button type="button" class="reading-mode" role="radio"
                            aria-checked="@(Choice.Mode == mode ? "true" : "false")"
                            @onclick="() => ChooseModeAsync(mode)">
                        <span class="reading-mode-name">@ModeName(mode)</span>
                        <span class="reading-mode-note">@ModeNote(mode)</span>
                    </button>
                }
            </div>

            @* Вывод повторён под ступенями (I10), как в панели профиля (E4): на телефоне
               панель закрывает результат, а смену ступени должно быть видно сразу.
               На широком экране повтор скрыт — вывод и так рядом. *@
            <div class="panel-preview reading-preview" aria-live="polite">
                <span class="panel-preview-label">@L["Preview.Label"]</span>
                @* Изменённое сменой настройки подсвечено и здесь (D19): на телефоне
                   вывод под листом не виден. Ключ — тот же, что у строк вывода; пока
                   подсветка идёт, повтор начинается со строки первого изменения. *@
                <span class="panel-preview-text" @key="ChangeKey">@if (string.IsNullOrEmpty(Preview))
                {@L["Preview.Empty"]}
                else
                {<ChangedText Segments="ChangedText.Of(Changes, Preview)" />}</span>
            </div>

            @* Под ступенями — два блока правил (I8): сначала правила чтения на арабском,
               потом правила таджвида, как в группах I6. Оба свёрнуты, пока их не откроют;
               в заголовке — дробь «читаемых/всего» (I12), видная и у свёрнутого: читается
               правило, которое не выключено (счёт мадда не в счёт). Диктор читает её
               словами, числа берутся из каталога и выбора. Счёт и переключатель «Неполного таджвида» стоят в строке
               своего правила (I3, I4), отдельного списка нет. *@
            @foreach (var group in Groups)
            {
                var tier = group.Key;
                var off = IsOff(tier);
                var open = _openBlocks.Contains(tier);
                var blockId = BlockId(tier);
                var total = group.Count();
                var read = group.Count(rule => !IsOff(rule));

                <section class="reading-block">
                    <h3 class="reading-group @(off ? "is-off" : null)">
                        <button type="button" class="reading-group-toggle"
                                aria-expanded="@(open ? "true" : "false")" aria-controls="@blockId"
                                @onclick="() => ToggleBlock(tier)">
                            <span class="reading-group-name">@GroupName(tier)</span>
                            <span class="reading-group-count"><span aria-hidden="true">@read/@total</span><span class="visually-hidden">@L["Reading.GroupCountLabel", read, total]</span></span>
                            <svg class="reading-group-chevron" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 9l6 6 6-6" />
                            </svg>
                        </button>
                    </h3>

                    @* Свёрнутый блок (D21) раскрывается плавно и остаётся в разметке: inert —
                       Tab и диктор его не достают. *@
                    <div id="@blockId" class="fold @(open ? "is-open" : null)" inert="@(!open)" aria-hidden="@(open ? null : "true")">
                    <div class="fold-inner">
                    <div class="reading-block-body">
                        @if (Variants && tier == TajweedTier.Tajweed)
                        {
                            @NoteWithDetails("counts", "Reading.CountsLead", "Reading.CountsNote")
                            @NoteWithDetails("switchable", "Reading.SwitchableLead", "Reading.SwitchableNote")
                        }

                        <ul class="reading-list">
                            @foreach (var rule in group)
                            {
                                var example = rule.Examples.FirstOrDefault();
                                var counts = Variants && rule.HasVariants;
                                var switchable = Variants && rule.Switchable;
                                var on = Choice.Reads(rule);
                                var described = _openDescriptions.Contains(rule.Id);
                                var descriptionId = $"reading-rule-text-{rule.Id}";

                                <li class="reading-rule @(IsOff(rule) ? "is-off" : null)">
                                    <button type="button" class="reading-rule-toggle"
                                            aria-expanded="@(described ? "true" : "false")" aria-controls="@descriptionId"
                                            aria-label="@(L["Reading.DescriptionLabel", rule.Name.Current])"
                                            @onclick="() => ToggleDescription(rule)">
                                        <svg class="reading-rule-chevron" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M9 6l6 6-6 6" />
                                        </svg>
                                    </button>
                                    <span class="reading-rule-main">
                                        <span class="reading-rule-head">
                                            <span class="reading-rule-title">
                                                <span class="reading-rule-name">@rule.Name.Current</span>
                                                <span class="reading-rule-translation">(@rule.Translation.Current)</span>
                                            </span>
                                            <span class="reading-rule-arabic" dir="rtl" lang="ar">@rule.ArabicName</span>
                                        </span>
                                        @if (example is not null)
                                        {
                                            <span class="reading-example">
                                                <span class="reading-rule-arabic" dir="rtl" lang="ar">@example.Arabic</span>
                                                <span class="reading-example-arrow" aria-hidden="true">→</span>
                                                <span class="reading-example-text" aria-live="@(counts || switchable ? "polite" : null)">@ExampleOf(example)</span>
                                            </span>
                                        }
                                        <span id="@descriptionId" class="fold @(described ? "is-open" : null)" inert="@(!described)" aria-hidden="@(described ? null : "true")"><span class="fold-inner"><span class="reading-rule-text">@rule.Description.Current</span></span></span>
                                    </span>
                                    @if (counts || switchable)
                                    {
                                        <span class="reading-rule-controls">
                                            @if (counts)
                                            {
                                                <span class="reading-counts" role="radiogroup" aria-label="@(L["Reading.CountLabel", rule.Name.Current])">
                                                    @foreach (var count in rule.Counts)
                                                    {
                                                        <button type="button" class="reading-count" role="radio"
                                                                aria-checked="@(Choice.CountOf(rule) == count ? "true" : "false")"
                                                                @onclick="() => ChooseCountAsync(rule, count)">@count</button>
                                                    }
                                                </span>
                                            }
                                            @if (switchable)
                                            {
                                                <button type="button" class="reading-switch" role="switch"
                                                        aria-checked="@(on ? "true" : "false")"
                                                        aria-label="@(L["Reading.SwitchLabel", rule.Name.Current])"
                                                        @onclick="() => SwitchRuleAsync(rule, !on)">
                                                    <span class="reading-switch-track" aria-hidden="true"></span>
                                                    @* Обе надписи занимают одно место: ширина переключателя не зависит от состояния (I9). *@
                                                    <span class="reading-switch-text">
                                                        <span class="@(on ? null : "is-hidden")">@L["Reading.On"]</span>
                                                        <span class="@(on ? "is-hidden" : null)">@L["Reading.Off"]</span>
                                                    </span>
                                                </button>
                                            }
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                    </div>
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TajweedRuleCatalog Catalog { get; set; } = new();

    [Parameter, EditorRequired]
    public ReadingChoice Choice { get; set; } = ReadingChoice.Default;

    [Parameter]
    public EventCallback<ReadingChoice> ChoiceChanged { get; set; }

    /// <summary>
    /// Транслитерация текущим выбором и профилем страницы. Пример правила в «Неполном
    /// таджвиде» пересчитывается под выбранный счёт — так видно, что счёт меняет (I3).
    /// Без неё — или когда она вернула <c>null</c> — показывается пример из каталога,
    /// посчитанный полным таджвидом.
    /// </summary>
    [Parameter]
    public Func<string, string?>? Transliterate { get; set; }

    /// <summary>Вывод страницы: на телефоне панель закрывает результат и повторяет его в себе (I10).</summary>
    [Parameter]
    public string Preview { get; set; } = string.Empty;

    /// <summary>Что изменила последняя смена настройки (D19); <c>null</c> — подсветки нет.</summary>
    [Parameter]
    public OutputDiff? Changes { get; set; }

    /// <summary>Новый при каждой смене настройки — подсветка проигрывается заново.</summary>
    [Parameter]
    public int ChangeKey { get; set; }

    /// <summary>Смена настройки не изменила вывод — подпись в шапке панели (D19).</summary>
    [Parameter]
    public bool Unchanged { get; set; }

    private static readonly ReadingMode[] Modes = { ReadingMode.Full, ReadingMode.Variants, ReadingMode.Plain };

    protected override string Panel => "reading";

    /// <summary>Раскрытые блоки правил (I8). При открытии панели оба свёрнуты.</summary>
    private readonly HashSet<TajweedTier> _openBlocks = new();

    /// <summary>
    /// Правила с раскрытым описанием (I9). Описание свёрнуто, пока его не раскроют
    /// стрелкой у названия: длинные описания не растягивают список.
    /// </summary>
    private readonly HashSet<string> _openDescriptions = new();

    /// <summary>Пояснения над правилами с раскрытыми подробностями (I14).</summary>
    private readonly HashSet<string> _openNotes = new();

    private bool Variants => Choice.Mode == ReadingMode.Variants;

    protected override Task BeforeOpenAsync()
    {
        _openBlocks.Clear();
        _openDescriptions.Clear();
        _openNotes.Clear();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Пояснение из одной короткой фразы; подробности — под ссылкой «Подробнее» (I14).
    /// Тело тот же приём, что у описаний правил: свёрнуто — inert и aria-hidden.
    /// </summary>
    private RenderFragment NoteWithDetails(string id, string leadKey, string detailsKey) => __builder =>
    {
        var open = _openNotes.Contains(id);
        var detailsId = $"reading-note-{id}";
        <p class="reading-variants-note">
            @L[leadKey]
            <button type="button" class="reading-note-more" aria-expanded="@(open ? "true" : "false")" aria-controls="@detailsId"
                    @onclick="() => ToggleNote(id)">@L[open ? "Reading.Less" : "Reading.More"]</button>
        </p>
        <div id="@detailsId" class="fold @(open ? "is-open" : null)" inert="@(!open)" aria-hidden="@(open ? null : "true")">
            <div class="fold-inner">
                <p class="reading-variants-note">@L[detailsKey]</p>
            </div>
        </div>
    };

    private void ToggleNote(string id)
    {
        if (!_openNotes.Remove(id))
            _openNotes.Add(id);
    }

    private void ToggleDescription(TajweedRule rule)
    {
        if (!_openDescriptions.Remove(rule.Id))
            _openDescriptions.Add(rule.Id);
    }

    private void ToggleBlock(TajweedTier tier)
    {
        if (!_openBlocks.Remove(tier))
            _openBlocks.Add(tier);
    }

    private static string BlockId(TajweedTier tier) => $"reading-rules-{tier.ToString().ToLowerInvariant()}";

    /// <summary>
    /// Сначала правила чтения на арабском, потом правила таджвида (I6, I8). Заголовок
    /// блока прилипает к верху панели, пока блок прокручивается: видно, к какому блоку
    /// относится правило перед глазами.
    /// </summary>
    private IEnumerable<IGrouping<TajweedTier, TajweedRule>> Groups =>
        Catalog.Rules.GroupBy(r => r.Tier).OrderBy(g => g.Key);

    /// <summary>
    /// В обычном чтении правила таджвида не читаются — они видны, но погашены.
    /// В «Неполном таджвиде» погашены и правила, выключенные по одному (I4).
    /// </summary>
    private bool IsOff(TajweedRule rule) =>
        IsOff(rule.Tier) || (Choice.Mode == ReadingMode.Variants && rule.Switchable && !Choice.Reads(rule));

    private bool IsOff(TajweedTier tier) =>
        Choice.Mode == ReadingMode.Plain && tier == TajweedTier.Tajweed;

    private string ExampleOf(TajweedRuleExample example) =>
        Transliterate?.Invoke(example.Arabic) ?? example.Transliteration;

    private string ModeName(ReadingMode mode) => ModeName(L, mode);

    /// <summary>Имя ступени — и у кнопки, и в метке над выводом (D17).</summary>
    public static string ModeName(IStringLocalizer<Strings> L, ReadingMode mode) => mode switch
    {
        ReadingMode.Variants => L["Mode.Variants"],
        ReadingMode.Plain => L["Mode.Plain"],
        _ => L["Mode.Full"],
    };

    private string ModeNote(ReadingMode mode) => mode switch
    {
        ReadingMode.Variants => L["ModeNote.Variants"],
        ReadingMode.Plain => L["ModeNote.Plain"],
        _ => L["ModeNote.Full"],
    };

    private string GroupName(TajweedTier tier) => tier switch
    {
        TajweedTier.Tajweed => L["Group.Tajweed"],
        _ => L["Group.Base"],
    };

    /// <summary>
    /// Выбранная ступень сразу видна в выводе, а панель остаётся открытой при любой
    /// ступени (I10): ступени сравнивают, переключая их подряд. На телефоне вывод
    /// повторён в панели. Закрывают её, как другие, крестиком, Escape или кнопкой.
    /// «Неполный таджвид» раскрывает «Правила таджвида» (I8): счёты и переключатели
    /// выбираются здесь же, в строках правил.
    /// </summary>
    private Task ChooseModeAsync(ReadingMode mode)
    {
        if (mode == ReadingMode.Variants)
            _openBlocks.Add(TajweedTier.Tajweed);

        return ChoiceChanged.InvokeAsync(Choice.WithMode(mode));
    }

    private Task ChooseCountAsync(TajweedRule rule, int count) =>
        ChoiceChanged.InvokeAsync(Choice.WithCount(rule.Id, count));

    private Task SwitchRuleAsync(TajweedRule rule, bool on) =>
        ChoiceChanged.InvokeAsync(Choice.WithRule(rule.Id, on));
}

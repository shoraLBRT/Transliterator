@using Transliterator.Core.Services
@using Transliterator.Domain.Exceptions
@inject ProfileEditor Editor
@inject IJSRuntime JS

<div class="profile-actions">
    @switch (_mode)
    {
        case Mode.None:
            <div class="buttons">
                <button type="button" @onclick="StartCopyAsync">Создать копию</button>
                @if (!IsBuiltIn)
                {
                    <button type="button" @onclick="StartRename">Переименовать</button>
                    <button type="button" class="danger" @onclick="StartDelete">Удалить</button>
                }
            </div>
            <div class="buttons">
                <button type="button" @onclick="ExportAsync">Экспорт JSON</button>
                <label class="button-like">
                    Импорт JSON
                    <InputFile class="visually-hidden" accept=".json,application/json" OnChange="ImportAsync" />
                </label>
            </div>
            break;

        case Mode.Copy:
        case Mode.Rename:
            <form class="profile-name-form" @onsubmit="SubmitNameAsync" @onsubmit:preventDefault>
                <label for="profile-name">
                    @(_mode == Mode.Copy ? $"Имя копии профиля «{Profile.Name}»" : $"Новое имя профиля «{Profile.Name}»")
                </label>
                <input id="profile-name" autocomplete="off" spellcheck="false"
                       @bind="_name" @bind:event="oninput" @bind:after="CheckNameAsync" />

                @if (_nameProblem is not null)
                {
                    <p class="field-error" role="alert">@_nameProblem</p>
                }

                <div class="buttons">
                    <button type="submit" disabled="@(_nameProblem is not null)">
                        @(_mode == Mode.Copy ? "Создать" : "Переименовать")
                    </button>
                    <button type="button" @onclick="Cancel">Отмена</button>
                </div>
            </form>
            break;

        case Mode.Delete:
            <div class="profile-confirm" role="alertdialog" aria-labelledby="profile-confirm-text">
                <p id="profile-confirm-text">Удалить профиль «@Profile.Name»? Вернуть его будет нельзя.</p>
                <div class="buttons">
                    <button type="button" class="danger" @onclick="DeleteAsync">Удалить</button>
                    <button type="button" @onclick="Cancel">Отмена</button>
                </div>
            </div>
            break;
    }

    @if (_info is not null)
    {
        <p class="field-info" role="status">@_info</p>
    }

    @if (_importProblems.Count > 0)
    {
        <div class="field-error" role="alert">
            <p>Профиль не импортирован:</p>
            <ul>
                @foreach (var problem in _importProblems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
    }

    @if (_error is not null)
    {
        <p class="field-error" role="alert">@_error</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TransliterationProfile Profile { get; set; } = default!;

    /// <summary>Встроенный профиль можно только скопировать и выгрузить.</summary>
    [Parameter]
    public bool IsBuiltIn { get; set; }

    /// <summary>
    /// Список профилей изменился. Аргумент — имя профиля, который надо выбрать:
    /// созданная копия, новое имя, импортированный профиль; <c>null</c> после удаления.
    /// </summary>
    [Parameter]
    public EventCallback<string?> Changed { get; set; }

    /// <summary>
    /// Файл больше этого не читается вовсе: в символах профиль ограничен
    /// <see cref="ProfileJson.MaxLength"/>, а символ UTF-8 — не больше четырёх байт.
    /// </summary>
    private const long MaxFileBytes = ProfileJson.MaxLength * 4L;

    private enum Mode { None, Copy, Rename, Delete }

    private Mode _mode;
    private string _name = string.Empty;
    private string? _nameProblem;
    private string? _error;
    private string? _info;
    private IReadOnlyList<string> _importProblems = Array.Empty<string>();
    private string? _shownFor;

    // Выбрали другой профиль — начатая над прежним форма к нему уже не относится.
    protected override void OnParametersSet()
    {
        if (_shownFor == Profile.Name)
            return;

        _shownFor = Profile.Name;
        Reset();
    }

    private async Task StartCopyAsync()
    {
        Reset();
        _mode = Mode.Copy;
        _name = await Editor.SuggestCopyNameAsync(Profile.Name);
        await CheckNameAsync();
    }

    private void StartRename()
    {
        Reset();
        _mode = Mode.Rename;
        _name = Profile.Name;
        _nameProblem = "Имя не изменилось.";
    }

    private void StartDelete()
    {
        Reset();
        _mode = Mode.Delete;
    }

    private void Cancel() => Reset();

    private void Reset()
    {
        _mode = Mode.None;
        _name = string.Empty;
        _nameProblem = null;
        _error = null;
        _info = null;
        _importProblems = Array.Empty<string>();
    }

    /// <summary>Имя проверяется на каждую букву: кнопка не нажимается, пока имя не годится.</summary>
    private async Task CheckNameAsync() =>
        _nameProblem = await Editor.CheckNameAsync(_name, _mode == Mode.Rename ? Profile.Name : null);

    private async Task SubmitNameAsync()
    {
        try
        {
            var profile = _mode == Mode.Copy
                ? await Editor.CreateCopyAsync(Profile.Name, _name)
                : await Editor.RenameAsync(Profile.Name, _name);

            Reset();
            await Changed.InvokeAsync(profile.Name);
        }
        catch (TransliterationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Editor.DeleteAsync(Profile.Name);
            Reset();
            await Changed.InvokeAsync(null);
        }
        catch (TransliterationException ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Выгружает выбранный профиль файлом в формате <c>Standard.json</c>.</summary>
    private async Task ExportAsync()
    {
        Reset();

        try
        {
            await JS.InvokeVoidAsync("transliteratorFiles.download",
                                     ProfileJson.FileNameFor(Profile.Name), ProfileJson.Export(Profile));
        }
        catch (JSException ex)
        {
            _error = $"Файл не выгружен: {ex.Message}";
        }
    }

    /// <summary>
    /// Импорт файла. Всё, что в файле не так, показывается списком; занятое имя
    /// не перезаписывается, а профиль сохраняется копией — и это сказано.
    /// </summary>
    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        Reset();

        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxFileBytes));
            var result = await Editor.ImportAsync(await reader.ReadToEndAsync());

            if (result.Profile is null)
            {
                _importProblems = result.Problems;
                return;
            }

            var message = result.RenamedFrom is null
                ? $"Профиль «{result.Profile.Name}» импортирован."
                : $"Профиль «{result.RenamedFrom}» уже есть — импортирован как «{result.Profile.Name}».";

            // Импортированный профиль сейчас станет выбранным; сообщение о нём
            // смена профиля стирать не должна.
            _shownFor = result.Profile.Name;
            await Changed.InvokeAsync(result.Profile.Name);
            _info = message;
        }
        catch (IOException)
        {
            _error = "Файл слишком большой для профиля.";
        }
        catch (TransliterationException ex)
        {
            _error = ex.Message;
        }
    }
}

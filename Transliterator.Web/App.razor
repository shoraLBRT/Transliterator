@using Transliterator.Core.Services
@inject IProfileRepository Profiles
@inject ICorpusRepository Corpus
@inject ITransliterationService Transliteration
@inject IJSRuntime JS
@inject ILogger<App> Logger

<div class="shell @(HasText ? "is-active" : null)">
    <main class="stage">
        <h1 class="visually-hidden">Транслитерация Корана кириллицей</h1>

        @* Подсказка печатается скриптом и сменяет себя. Экранному диктору она не
           читается: для него у поля есть постоянная подпись, а текст, меняющийся
           каждые несколько секунд, мешал бы. *@
        <p class="hint" aria-hidden="true"><span class="hint-text" @ref="_hint"></span></p>

        <div class="composer">
            <label for="arabic" class="visually-hidden">Арабский текст для транслитерации</label>
            <textarea id="arabic" class="composer-input" dir="rtl" lang="ar" rows="1"
                      spellcheck="false" autocomplete="off" placeholder="@_placeholder"
                      value="@_arabic" @oninput="OnInput" @ref="_input"></textarea>

            <div class="composer-bar">
                @if (_surahs.Count > 0)
                {
                    <SurahPicker Surahs="_surahs" Chosen="ChooseAsync" />
                }

                @if (HasText)
                {
                    <button type="button" class="icon-button" title="Очистить" aria-label="Очистить поле" @onclick="ClearAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                }
            </div>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        else if (_result.Length > 0)
        {
            <section class="result" aria-labelledby="result-title">
                <h2 id="result-title" class="visually-hidden">Транслитерация</h2>
                <p class="result-text">@_result</p>

                <button type="button" class="copy-button" @onclick="CopyAsync">
                    @if (_copyState == CopyState.Copied)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                        <span>Скопировано</span>
                    }
                    else if (_copyState == CopyState.Failed)
                    {
                        <span>Выделите текст вручную</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
                        <span>Копировать</span>
                    }
                </button>
            </section>
        }
    </main>

    <footer class="footer">
        <span>Кириллица по правилам таджвида</span>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/shoraLBRT/Transliterator" target="_blank" rel="noopener">GitHub</a>
    </footer>
</div>

@code {
    /// <summary>
    /// Первая итерация пишет одним профилем. Выбор профиля, редактор и импорт
    /// сняты со страницы (D5), но в ядре остаются и вернутся следующей итерацией.
    /// </summary>
    private const string ProfileName = "Standard";

    /// <summary>Первый аят Аль-Фатихи — на случай, если корпус не прочитался.</summary>
    private const string FallbackPlaceholder = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ";

    /// <summary>
    /// Короткие, чтобы на телефоне помещаться в две строки и успевать прочитаться
    /// за паузу: подсказка — не инструкция, а первое знакомство со страницей.
    /// Пример с арабским текстом — обещание: вставив его, человек получит ровно
    /// показанное, и это проверяет <c>PageHintTests</c>.
    /// </summary>
    private static readonly string[] Hints =
    {
        "Транслит арабского текста на кириллицу",
        "بِسْمِ ٱللَّه — бисми-лляяh",
        "Транслит с правилами таджвида",
        "الْحَمْدُ لِلَّه — аль-хIамду лилляяh",
        "Арабский текст — русскими буквами",
        "مَالِكِ يَوْمِ الدِّين — маалики йауми-ддиин",
        "Суры для примера — под полем ввода"
    };

    private enum CopyState { Idle, Copied, Failed }

    private IReadOnlyList<CorpusSurah> _surahs = Array.Empty<CorpusSurah>();
    private TransliterationProfile? _profile;
    private string _placeholder = FallbackPlaceholder;
    private string _arabic = string.Empty;
    private string _result = string.Empty;
    private string? _error;

    private ElementReference _hint;
    private ElementReference _input;
    private bool _resizePending;
    private CopyState _copyState;
    private int _copyStamp;

    private bool HasText => !string.IsNullOrWhiteSpace(_arabic);

    protected override async Task OnInitializedAsync()
    {
        _surahs = await LoadSurahsAsync();
        _placeholder = _surahs.FirstOrDefault(s => s.Number == 1)?.Ayahs.FirstOrDefault()?.Arabic ?? FallbackPlaceholder;

        _profile = await Profiles.GetProfileAsync(ProfileName);
        if (_profile is null)
            _error = $"Профиль {ProfileName} не загрузился. Перезагрузите страницу.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Подсказка и высота поля — удобство, а не работа страницы: не загрузился
        // скрипт — поле остаётся полем, и транслитерация работает.
        try
        {
            if (firstRender)
            {
                await JS.InvokeVoidAsync("page.typewriter", _hint, Hints, _input);
                await JS.InvokeVoidAsync("page.autosize", _input);
            }

            if (_resizePending)
            {
                _resizePending = false;
                await JS.InvokeVoidAsync("page.resize", _input);
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Page script is unavailable");
        }
    }

    /// <summary>
    /// Битый корпус — сломанная сборка, и тесты её не пропустят. Но если он всё же
    /// доехал, страница остаётся рабочей без готовых сур: ввести текст руками можно
    /// и без них.
    /// </summary>
    private async Task<IReadOnlyList<CorpusSurah>> LoadSurahsAsync()
    {
        try
        {
            return await Corpus.GetAllSurahsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Corpus could not be read");
            return Array.Empty<CorpusSurah>();
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _arabic = e.Value?.ToString() ?? string.Empty;
        Calculate();
    }

    /// <summary>
    /// Сура заменяет текст в поле целиком — так же, как если бы его вставили
    /// руками, — и сразу показывает результат. Аят на строке (D3).
    /// </summary>
    private void ChooseAsync(CorpusSurah surah)
    {
        _arabic = CorpusText.Arabic(surah);
        _resizePending = true;
        Calculate();
    }

    private async Task ClearAsync()
    {
        _arabic = string.Empty;
        _resizePending = true;
        Calculate();

        await _input.FocusAsync();
    }

    private async Task CopyAsync()
    {
        var copied = false;

        try
        {
            copied = await JS.InvokeAsync<bool>("page.copy", _result);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Clipboard is unavailable");
        }

        _copyState = copied ? CopyState.Copied : CopyState.Failed;

        // Отметка гаснет сама. Второе нажатие раньше срока продлевает её, а не
        // гасит на полпути: гасит только последнее.
        var stamp = ++_copyStamp;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2));

        if (stamp == _copyStamp)
            _copyState = CopyState.Idle;
    }

    /// <summary>
    /// Пересчёт на каждую правку, без кнопки. Профиль загружен заранее, и путь
    /// «текст + профиль» (C2) синхронный: ответ на прежний ввод не может прийти
    /// после ответа на новый и затереть его.
    /// </summary>
    private void Calculate()
    {
        if (_profile is null)
            return;

        _copyState = CopyState.Idle;

        try
        {
            _result = Transliteration.Transliterate(_arabic, _profile).TransliteratedText;
            _error = null;
        }
        catch (Exception ex)
        {
            // Ловится всё, а не только TransliterationException: текст вставляют
            // откуда придётся, и необработанное исключение в WebAssembly гасит
            // страницу целиком — до перезагрузки она больше не отвечает.
            Logger.LogError(ex, "Transliteration failed");
            _result = string.Empty;
            _error = ex.Message;
        }
    }
}

@using Transliterator.Core.Repositories
@using Transliterator.Core.Services
@using Transliterator.Domain.Exceptions
@inject IProfileRepository Profiles
@inject UserProfileRepository UserProfiles
@inject ProfileEditor Editor
@inject ICorpusRepository Corpus
@inject ITransliterationService Transliteration
@inject IJSRuntime JS
@inject ILogger<App> Logger

<div class="page">
    <aside class="settings">
        <ProfilePanel Profiles="_profiles" BuiltIn="_builtIn" Selected="_profile" SelectedChanged="SelectAsync" />

        @if (_profile is not null)
        {
            <ProfileActions Profile="_profile" IsBuiltIn="_builtIn.Contains(_profile.Name)" Changed="OnProfilesChangedAsync" />
        }

        @if (_notices.Count > 0)
        {
            <ul class="notices" role="status">
                @foreach (var notice in _notices)
                {
                    <li>@notice</li>
                }
            </ul>
        }

        @if (_surahs.Count > 0)
        {
            <SurahPanel Surahs="_surahs" Chosen="Choose" />
        }
    </aside>

    <main class="work">
        <label for="arabic">Арабский текст</label>
        <textarea id="arabic" class="arabic" dir="rtl" lang="ar" rows="8" spellcheck="false"
                  value="@_arabic" @oninput="OnInput"></textarea>

        <label for="result">Транслитерация</label>
        <textarea id="result" class="result" dir="ltr" rows="8" readonly
                  value="@_result"></textarea>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        @if (_editError is not null)
        {
            <p class="error" role="alert">@_editError</p>
        }

        @if (_profile is not null)
        {
            <RulesPanel Profile="_profile" Editable="!_builtIn.Contains(_profile.Name)" RuleChanged="ChangeRuleAsync" />
        }
    </main>
</div>

@code {
    private const string DefaultProfileName = "Standard";

    /// <summary>
    /// Ключ localStorage с именем выбранного профиля. Хранится только имя:
    /// сами профили лежат в хранилище, и копия профиля здесь разошлась бы с ним.
    /// </summary>
    private const string SelectedProfileKey = "transliterator.selected-profile";

    private IReadOnlyList<TransliterationProfile> _profiles = Array.Empty<TransliterationProfile>();
    private IReadOnlyList<CorpusSurah> _surahs = Array.Empty<CorpusSurah>();
    private IReadOnlySet<string> _builtIn = new HashSet<string>();
    private IReadOnlyList<string> _notices = Array.Empty<string>();
    private TransliterationProfile? _profile;
    private string _arabic = string.Empty;
    private string _result = string.Empty;
    private string? _error;
    private string? _editError;

    protected override async Task OnInitializedAsync()
    {
        _surahs = await LoadSurahsAsync();
        _profiles = await LoadProfilesAsync();

        if (_profiles.Count == 0)
        {
            _error = "Нет ни одного профиля.";
            return;
        }

        // Сохранённого профиля может уже не быть: его удалили или переименовали.
        // Тогда — Standard, а без него первый по списку, но не пустая страница.
        var stored = await ReadStoredProfileNameAsync();

        _profile = _profiles.FirstOrDefault(p => p.Name == stored)
                ?? _profiles.FirstOrDefault(p => p.Name == DefaultProfileName)
                ?? _profiles[0];
    }

    /// <summary>
    /// Список — из <see cref="ITransliterationService.GetAvailableProfilesAsync"/>,
    /// а не из разметки: профиль, добавленный в хранилище, появляется в панели сам.
    /// Сами профили — из хранилища: панели нужно описание, а не только имя.
    /// </summary>
    private async Task<IReadOnlyList<TransliterationProfile>> LoadProfilesAsync()
    {
        var profiles = new List<TransliterationProfile>();

        foreach (var name in await Transliteration.GetAvailableProfilesAsync())
            if (await Profiles.GetProfileAsync(name) is { } profile)
                profiles.Add(profile);

        var builtIn = new HashSet<string>(StringComparer.Ordinal);
        foreach (var profile in profiles)
            if (await UserProfiles.IsBuiltInAsync(profile.Name))
                builtIn.Add(profile.Name);

        _builtIn = builtIn;

        // Битая запись в localStorage список не роняет: профиль пропущен,
        // и страница говорит, какой и почему.
        _notices = UserProfiles.Problems.ToList();

        return profiles;
    }

    /// <summary>
    /// Битый корпус — сломанная сборка, и тесты её не пропустят. Но если он всё же
    /// доехал, страница остаётся рабочей без панели сур: ввести текст руками можно
    /// и без неё.
    /// </summary>
    private async Task<IReadOnlyList<CorpusSurah>> LoadSurahsAsync()
    {
        try
        {
            return await Corpus.GetAllSurahsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Corpus could not be read");
            return Array.Empty<CorpusSurah>();
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _arabic = e.Value?.ToString() ?? string.Empty;
        Calculate();
    }

    /// <summary>
    /// Выбор суры заменяет текст в поле целиком — так же, как если бы его вставили
    /// руками, — и сразу показывает результат.
    /// </summary>
    private void Choose(CorpusSurah surah)
    {
        _arabic = CorpusText.Arabic(surah);
        Calculate();
    }

    /// <summary>Смена профиля пересчитывает вывод; введённый текст не трогается.</summary>
    private async Task SelectAsync(TransliterationProfile profile)
    {
        _profile = profile;
        _editError = null;
        Calculate();

        await StoreProfileNameAsync(profile.Name);
    }

    /// <summary>
    /// Профиль создан, переименован или удалён (E2): список перечитывается, и выбирается
    /// тот профиль, с которым только что работали, — после удаления Standard.
    /// </summary>
    private async Task OnProfilesChangedAsync(string? selectName)
    {
        _profiles = await LoadProfilesAsync();

        var next = _profiles.FirstOrDefault(p => p.Name == selectName)
                ?? _profiles.FirstOrDefault(p => p.Name == DefaultProfileName)
                ?? _profiles.FirstOrDefault();

        if (next is null)
        {
            _profile = null;
            return;
        }

        await SelectAsync(next);
    }

    /// <summary>
    /// Правка графемы: сразу на тексте и сразу в хранилище. Не записалось — правка
    /// всё равно видна, а под полем результата сказано, что она не сохранена.
    /// </summary>
    private async Task ChangeRuleAsync(KeyValuePair<string, string> edit)
    {
        if (_profile is null)
            return;

        try
        {
            await Editor.SetRuleAsync(_profile, edit.Key, edit.Value);
            _editError = null;
        }
        catch (TransliterationException ex)
        {
            _editError = ex.Message;
        }

        Calculate();
    }

    /// <summary>
    /// Пересчёт на каждую правку, без кнопки. Профиль загружен заранее, и путь
    /// «текст + профиль» (C2) синхронный: ответ на прежний ввод не может прийти
    /// после ответа на новый и затереть его.
    /// </summary>
    private void Calculate()
    {
        if (_profile is null)
            return;

        try
        {
            _result = Transliteration.Transliterate(_arabic, _profile).TransliteratedText;
            _error = null;
        }
        catch (Exception ex)
        {
            // Ловится всё, а не только TransliterationException: текст вставляют
            // откуда придётся, и необработанное исключение в WebAssembly гасит
            // страницу целиком — до перезагрузки она больше не отвечает.
            // Ошибка разбора на одном вводе не должна отнимать поле у следующего.
            Logger.LogError(ex, "Transliteration failed");
            _result = string.Empty;
            _error = ex.Message;
        }
    }

    // localStorage бывает недоступен: приватный режим, запрет сайтам хранить данные.
    // Выбор профиля — удобство, а не данные, и без хранилища страница просто
    // забудет его при перезагрузке, а не перестанет работать.

    private async Task<string?> ReadStoredProfileNameAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", SelectedProfileKey);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Selected profile could not be read from localStorage");
            return null;
        }
    }

    private async Task StoreProfileNameAsync(string name)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SelectedProfileKey, name);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Selected profile could not be saved to localStorage");
        }
    }
}

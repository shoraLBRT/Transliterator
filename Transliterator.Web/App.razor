@using Transliterator.Core.Repositories
@using Transliterator.Core.Services
@inject IProfileRepository Profiles
@inject ICorpusRepository Corpus
@inject ITransliterationService Transliteration
@inject IJSRuntime JS
@inject ILogger<App> Logger
@inject PagePanels Panels
@implements IDisposable

<div class="shell @(HasText ? "is-active" : null) @(Panels.Current is not null ? "has-panel" : null)">
    @* Язык интерфейса (D7): в углу страницы, видно сразу, ещё до поля. *@
    <LanguagePicker Chosen="ChangeLanguageAsync" />

    <main class="stage">
        <h1 class="visually-hidden">@L["Page.Heading"]</h1>

        @* Подсказка печатается скриптом и сменяет себя. Экранному диктору она не
           читается: для него у поля есть постоянная подпись, а текст, меняющийся
           каждые несколько секунд, мешал бы. *@
        <p class="hint" aria-hidden="true"><span class="hint-text" @ref="_hint"></span></p>

        <div class="composer">
            <label for="arabic" class="visually-hidden">@L["Composer.Label"]</label>
            <textarea id="arabic" class="composer-input" dir="rtl" lang="ar" rows="1"
                      spellcheck="false" autocomplete="off" placeholder="@_placeholder"
                      value="@_arabic" @oninput="OnInput" @ref="_input"></textarea>

            @* Под полем — только выбор суры (D6): он меняет сам текст. Как этот текст
               читать и писать — круглые кнопки сбоку, ниже. *@
            <div class="composer-bar">
                <div class="composer-tools">
                    @if (_surahs.Count > 0)
                    {
                        <SurahPicker Surahs="_surahs" Chosen="ChooseAsync" />
                    }
                </div>

                @if (HasText)
                {
                    <button type="button" class="icon-button" title="@L["Composer.ClearTitle"]" aria-label="@L["Composer.ClearLabel"]" @onclick="ClearAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                }
            </div>
        </div>

        @* Ступень чтения и профиль (D6). На широком экране — круглые кнопки у края
           страницы, и панель открывается колонкой рядом с полем и выводом, отодвигая
           их, а не закрывая. На телефоне двум колонкам нет места: кнопки стоят строкой
           под полем, панель — поверх вывода, как прежде. У каждой кнопки подписано, что
           выбрано сейчас («Полный таджвид», «Профиль: Standard»). *@
        @if (_catalog is not null || _profile is not null)
        {
            <aside class="side-rail" aria-label="@L["Rail.Label"]">
                @if (_catalog is not null)
                {
                    <ReadingPicker Catalog="_catalog" Choice="_reading" ChoiceChanged="ChangeReadingAsync"
                                   Transliterate="TransliterateExample" />
                }

                @if (_profile is not null)
                {
                    <ProfilePicker Profile="_profile" DefaultProfile="@DefaultProfile" Preview="@_result"
                                   ProfileChanged="ChangeProfileAsync" ProfileDeleted="ResetProfileAsync" />
                }
            </aside>
        }

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        else if (_result.Length > 0)
        {
            <section class="result" aria-labelledby="result-title">
                <h2 id="result-title" class="visually-hidden">@L["Result.Title"]</h2>
                <p class="result-text">@_result</p>

                <button type="button" class="copy-button" @onclick="CopyAsync">
                    @if (_copyState == CopyState.Copied)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                        <span>@L["Copy.Done"]</span>
                    }
                    else if (_copyState == CopyState.Failed)
                    {
                        <span>@L["Copy.Failed"]</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
                        <span>@L["Copy.Action"]</span>
                    }
                </button>
            </section>
        }
    </main>

    <footer class="footer">
        <span>@L["Footer.Tagline"]</span>
        <span aria-hidden="true">·</span>
        <a href="@FeedbackLink.RepositoryUrl" target="_blank" rel="noopener">GitHub</a>
        <FeedbackButton Arabic="@_arabic" Transliteration="@_result" />
    </footer>
</div>

@code {
    /// <summary>
    /// Профиль, которым страница пишет, пока человек не выбрал другой (E4): у каждого
    /// языка свой — с английским интерфейсом латиница (D7). Сохранённый выбор важнее:
    /// кто выбрал Standard и переключил язык, тот остаётся на Standard.
    /// </summary>
    private static string DefaultProfile => PageLanguages.Current.DefaultProfile;

    /// <summary>Ключ хранилища браузера с именем выбранного профиля (E4).</summary>
    private const string ProfileKey = "transliterator.profile";

    /// <summary>Первый аят Аль-Фатихи — на случай, если корпус не прочитался.</summary>
    private const string FallbackPlaceholder = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ";

    /// <summary>
    /// Фразы подсказки — ресурсы <c>Hint.1</c>, <c>Hint.2</c>… по порядку (D7).
    /// Короткие, чтобы на телефоне помещаться в две строки и успевать прочитаться
    /// за паузу: подсказка — не инструкция, а первое знакомство со страницей.
    /// Пример с арабским текстом — обещание: вставив его, человек получит ровно
    /// показанное профилем языка по умолчанию, и это проверяет <c>PageHintTests</c>.
    /// </summary>
    private string[] Hints() =>
        L.GetAllStrings(includeParentCultures: true)
         .Where(s => s.Name.StartsWith(HintPrefix, StringComparison.Ordinal))
         .OrderBy(s => int.Parse(s.Name[HintPrefix.Length..], System.Globalization.CultureInfo.InvariantCulture))
         .Select(s => s.Value)
         .ToArray();

    private const string HintPrefix = "Hint.";

    private enum CopyState { Idle, Copied, Failed }

    /// <summary>Ключ хранилища браузера, под которым живёт выбранная ступень чтения (I2).</summary>
    private const string ReadingKey = "transliterator.reading";

    private IReadOnlyList<CorpusSurah> _surahs = Array.Empty<CorpusSurah>();
    private TransliterationProfile? _profile;
    private TajweedRuleCatalog? _catalog;
    private ReadingChoice _reading = ReadingChoice.Default;
    private string _placeholder = FallbackPlaceholder;
    private string _arabic = string.Empty;
    private string _result = string.Empty;
    private string? _error;

    private ElementReference _hint;
    private ElementReference _input;
    private bool _resizePending;
    private CopyState _copyState;
    private int _copyStamp;

    private bool HasText => !string.IsNullOrWhiteSpace(_arabic);

    /// <summary>
    /// Открытая панель на широком экране отодвигает поле и вывод (D6) — для этого
    /// странице нужно знать, открыта ли какая-нибудь.
    /// </summary>
    private void OnPanelsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Panels.Changed -= OnPanelsChanged;

    protected override async Task OnInitializedAsync()
    {
        Panels.Changed += OnPanelsChanged;

        _surahs = await LoadSurahsAsync();
        _placeholder = _surahs.FirstOrDefault(s => s.Number == 1)?.Ayahs.FirstOrDefault()?.Arabic ?? FallbackPlaceholder;

        _profile = await Profiles.GetProfileAsync(DefaultProfile);
        if (_profile is null)
            _error = L["Error.ProfileNotLoaded", DefaultProfile];

        _catalog = LoadCatalog();
    }

    /// <summary>
    /// Каталог, как и корпус, — ресурс сборки, и битый ресурс не пройдёт тесты.
    /// Но не прочитался — страница остаётся рабочей: без выбора чтения, полным таджвидом.
    /// </summary>
    private TajweedRuleCatalog? LoadCatalog()
    {
        try
        {
            return EmbeddedTajweedRuleCatalog.Catalog;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Tajweed rule catalog could not be read");
            return null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Подсказка и высота поля — удобство, а не работа страницы: не загрузился
        // скрипт — поле остаётся полем, и транслитерация работает.
        try
        {
            if (firstRender)
            {
                await JS.InvokeVoidAsync("page.setDocument", PageLanguages.Current.Code,
                                         L["Page.Title"].Value, L["Page.Description"].Value);
                await RestoreDraftAsync();
                await JS.InvokeVoidAsync("page.typewriter", _hint, Hints(), _input);
                await JS.InvokeVoidAsync("page.autosize", _input);
                await RestoreReadingAsync();
                await RestoreProfileAsync();
            }

            if (_resizePending)
            {
                _resizePending = false;
                await JS.InvokeVoidAsync("page.resize", _input);
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Page script is unavailable");
        }
    }

    /// <summary>
    /// Битый корпус — сломанная сборка, и тесты её не пропустят. Но если он всё же
    /// доехал, страница остаётся рабочей без готовых сур: ввести текст руками можно
    /// и без них.
    /// </summary>
    private async Task<IReadOnlyList<CorpusSurah>> LoadSurahsAsync()
    {
        try
        {
            return await Corpus.GetAllSurahsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Corpus could not be read");
            return Array.Empty<CorpusSurah>();
        }
    }

    /// <summary>
    /// Выбор чтения помнится в браузере. Читается после первой отрисовки — до неё
    /// скрипта страницы может ещё не быть. Сверяется с каталогом: из хранилища
    /// приходит то, что сохранила прежняя версия страницы.
    /// </summary>
    private async Task RestoreReadingAsync()
    {
        if (_catalog is null)
            return;

        var stored = await JS.InvokeAsync<string?>("page.load", ReadingKey);
        var reading = ReadingChoice.Parse(stored, _catalog);

        if (reading.Serialize() == _reading.Serialize())
            return;

        _reading = reading;
        Calculate();
        StateHasChanged();
    }

    /// <summary>
    /// Текст поля, отложенный сменой языка (D7): страница перезагрузилась, а текст
    /// и его транслитерация на месте.
    /// </summary>
    private async Task RestoreDraftAsync()
    {
        if (await PageCulture.TakeDraftAsync(JS) is not { Length: > 0 } draft)
            return;

        _arabic = draft;
        _resizePending = true;
        Calculate();
        StateHasChanged();
    }

    /// <summary>Выбор языка запоминается, и страница загружается заново на нём.</summary>
    private async Task ChangeLanguageAsync(PageLanguage language)
    {
        try
        {
            await PageCulture.SwitchAsync(JS, language, _arabic);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Language could not be switched");
        }
    }

    /// <summary>
    /// Выбранный профиль помнится по имени. Нет такого больше — удалён в другой
    /// вкладке, хранилище очищено — страница остаётся на профиле по умолчанию.
    /// </summary>
    private async Task RestoreProfileAsync()
    {
        var stored = await JS.InvokeAsync<string?>("page.load", ProfileKey);
        if (string.IsNullOrEmpty(stored) || stored == _profile?.Name)
            return;

        try
        {
            if (await Profiles.GetProfileAsync(stored) is not { } profile)
                return;

            _profile = profile;
            Calculate();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Stored profile could not be read");
        }
    }

    /// <summary>
    /// Свой профиль удалён — страница возвращается к профилю языка по умолчанию,
    /// и выбор забывается: это не выбор человека, и при смене языка профиль
    /// по умолчанию снова сменится вместе с ним.
    /// </summary>
    private async Task ResetProfileAsync()
    {
        if (await Profiles.GetProfileAsync(DefaultProfile) is not { } profile)
            return;

        _profile = profile;
        Calculate();

        try
        {
            await JS.InvokeVoidAsync("page.save", ProfileKey, string.Empty);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Profile choice could not be reset");
        }
    }

    private async Task ChangeProfileAsync(TransliterationProfile profile)
    {
        _profile = profile;
        Calculate();

        try
        {
            await JS.InvokeVoidAsync("page.save", ProfileKey, profile.Name);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Profile choice could not be saved");
        }
    }

    private async Task ChangeReadingAsync(ReadingChoice reading)
    {
        _reading = reading;
        Calculate();

        try
        {
            await JS.InvokeVoidAsync("page.save", ReadingKey, reading.Serialize());
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Reading choice could not be saved");
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _arabic = e.Value?.ToString() ?? string.Empty;
        Calculate();
    }

    /// <summary>
    /// Сура заменяет текст в поле целиком — так же, как если бы его вставили
    /// руками, — и сразу показывает результат. Аят на строке (D3).
    /// </summary>
    private void ChooseAsync(CorpusSurah surah)
    {
        _arabic = CorpusText.Arabic(surah);
        _resizePending = true;
        Calculate();
    }

    private async Task ClearAsync()
    {
        _arabic = string.Empty;
        _resizePending = true;
        Calculate();

        await _input.FocusAsync();
    }

    private async Task CopyAsync()
    {
        var copied = false;

        try
        {
            copied = await JS.InvokeAsync<bool>("page.copy", _result);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Clipboard is unavailable");
        }

        _copyState = copied ? CopyState.Copied : CopyState.Failed;

        // Отметка гаснет сама. Второе нажатие раньше срока продлевает её, а не
        // гасит на полпути: гасит только последнее.
        var stamp = ++_copyStamp;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2));

        if (stamp == _copyStamp)
            _copyState = CopyState.Idle;
    }

    /// <summary>
    /// Пример правила в «Неполном таджвиде» (I3) — тем же профилем и выбором, что
    /// и вывод страницы. Сбой примера страницу не роняет: показывается пример каталога.
    /// </summary>
    private string? TransliterateExample(string arabic)
    {
        if (_profile is null)
            return null;

        try
        {
            return Transliteration.Transliterate(arabic, _profile, _reading.ToOptions()).TransliteratedText;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Example transliteration failed");
            return null;
        }
    }

    /// <summary>
    /// Пересчёт на каждую правку, без кнопки. Профиль загружен заранее, и путь
    /// «текст + профиль» (C2) синхронный: ответ на прежний ввод не может прийти
    /// после ответа на новый и затереть его.
    /// </summary>
    private void Calculate()
    {
        if (_profile is null)
            return;

        _copyState = CopyState.Idle;

        try
        {
            _result = Transliteration.Transliterate(_arabic, _profile, _reading.ToOptions()).TransliteratedText;
            _error = null;
        }
        catch (Exception ex)
        {
            // Ловится всё, а не только TransliterationException: текст вставляют
            // откуда придётся, и необработанное исключение в WebAssembly гасит
            // страницу целиком — до перезагрузки она больше не отвечает.
            Logger.LogError(ex, "Transliteration failed");
            _result = string.Empty;
            _error = ex.Message;
        }
    }
}

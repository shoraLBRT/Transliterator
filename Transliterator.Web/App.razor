@using Transliterator.Core.Repositories
@using Transliterator.Core.Services
@inject UserProfileRepository Profiles
@inject ICorpusRepository Corpus
@inject ITransliterationService Transliteration
@inject IJSRuntime JS
@inject ILogger<App> Logger
@inject PagePanels Panels
@implements IDisposable

<div class="shell @(HasText ? "is-active" : null) @(Panels.Current is not (null or "surah") ? "has-panel" : null)">
    @* Шапка (D13): знак и короткое имя страницы слева, язык интерфейса (D7) справа.
       Она в потоке, над полем, и ничего не перекрывает: прежде переключатель стоял
       в углу поверх страницы и на телефоне наезжал на подсказку. Знак — буква «нун»
       (чаша пером и точка в ней): ею открывается сура «Калам», «Перо». Тот же знак —
       в favicon.svg. *@
    <header class="topbar">
        <div class="topbar-brand">
            <svg class="topbar-mark" viewBox="5 5 22 22" aria-hidden="true">
                <path d="M6.5 8.5C6.5 18 10.5 23.5 16 23.5C21.5 23.5 25.5 18.5 25.5 11C24.2 17.1 20.8 20.7 16 20.7C11.2 20.7 7.6 16.1 6.5 8.5Z" />
                <circle cx="16" cy="11" r="2.2" />
            </svg>
            <h1 class="topbar-name">@L["Page.Heading"]</h1>
        </div>
        <LanguagePicker Chosen="ChangeLanguageAsync" />
    </header>

    <main class="stage">

        @* Подсказка печатается скриптом и сменяет себя. Экранному диктору она не
           читается: для него у поля есть постоянная подпись, а текст, меняющийся
           каждые несколько секунд, мешал бы. *@
        @* С текстом в поле подсказка плавно схлопывается (D16) и печать стоит: блок
           тот же .fold, что раскрывает панели (D21), — высота 1fr ↔ 0fr и прозрачность. *@
        <div class="fold hint-fold @(HasText ? null : "is-open")" inert="@HasText">
        <div class="fold-inner">
        <p class="hint" aria-hidden="true"><span class="hint-text" @ref="_hint"></span></p>
        </div>
        </div>

        <div class="composer">
            <label for="arabic" class="visually-hidden">@L["Composer.Label"]</label>
            <textarea id="arabic" class="composer-input" dir="rtl" lang="ar" rows="1"
                      spellcheck="false" autocomplete="off" placeholder="@_placeholder"
                      value="@_arabic" @oninput="OnInput" @ref="_input"></textarea>

            @* Под полем — только выбор суры (D6): он меняет сам текст. Как этот текст
               читать и писать — круглые кнопки сбоку, ниже. *@
            <div class="composer-bar" @ref="_composerBar">
                <div class="composer-tools">
                    @if (_surahs.Count > 0)
                    {
                        <SurahPicker Surahs="_surahs" Chosen="ChooseAsync" Current="CurrentSurah" />
                    }
                </div>

                @* Пустое поле предлагает вставку (D20) — там же, где у поля с текстом
                   крестик. Кнопка есть, только если браузер умеет читать буфер; не дал
                   прочитать — короткая строка под кнопками, не окно. *@
                @if (HasText)
                {
                    <button type="button" class="icon-button" title="@L["Composer.ClearTitle"]" aria-label="@L["Composer.ClearLabel"]" @onclick="ClearAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                }
                else if (_canPaste)
                {
                    <button type="button" class="picker-toggle paste-button" title="@L["Composer.PasteTitle"]" @onclick="PasteAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="6" y="4.5" width="12" height="16" rx="2" />
                            <path d="M9.5 4.5V3.5h5v1M9.5 10h5M9.5 13.5h5M9.5 17h3" />
                        </svg>
                        <span>@L["Composer.Paste"]</span>
                    </button>
                }
            </div>

            @if (!HasText && _canPaste)
            {
                <p class="composer-note" role="status">@_pasteNote</p>
            }
        </div>

        @* Быстрый старт (D24): в пустом состоянии три готовые суры одним щелчком.
           Тот же .fold, что у подсказки (D16): с текстом блок схлопывается и возвращается
           при очистке. Это тот же выбор суры, что под полем, — ChooseAsync. *@
        @if (_quickSurahs.Count > 0)
        {
            <div class="fold quick-start @(HasText ? null : "is-open")" inert="@HasText" aria-hidden="@(HasText ? "true" : null)">
            <div class="fold-inner">
                <div class="quick-start-body">
                    <div class="quick-start-chips" role="group" aria-label="@L["QuickStart.Label"]">
                        <span class="quick-start-label">@L["QuickStart.Label"]</span>
                        @foreach (var surah in _quickSurahs)
                        {
                            <button type="button" class="picker-toggle quick-chip" @onclick="() => ChooseAsync(surah)">@surah.Name.Current</button>
                        }
                    </div>
                    <p class="quick-start-note">@L["QuickStart.Note"]</p>
                </div>
            </div>
            </div>
        }

        @* Ступень чтения и профиль (D6). На широком экране — круглые кнопки у края
           страницы, и панель открывается колонкой рядом с полем и выводом, отодвигая
           их, а не закрывая. На телефоне двум колонкам нет места: кнопки стоят строкой
           под полем, панель — нижним листом (D14). У каждой кнопки подписано, что
           выбрано сейчас («Полный таджвид», «Профиль: Cyrillic»). *@
        @if (_catalog is not null || _profile is not null)
        {
            <aside class="side-rail" aria-label="@L["Rail.Label"]">
                @if (_catalog is not null)
                {
                    <ReadingPicker Catalog="_catalog" Choice="_reading" ChoiceChanged="ChangeReadingAsync"
                                   Transliterate="TransliterateExample" Preview="@_result" Changes="_changes"
                                   ChangeKey="_changeKey" Unchanged="_unchangedNote" @ref="_readingPicker" />
                }

                @if (_profile is not null)
                {
                    <ProfilePicker Profile="_profile" DefaultProfile="@DefaultProfile" Preview="@_result"
                                   Changes="_changes" ChangeKey="_changeKey" Unchanged="_unchangedNote"
                                   ProfileChanged="ChangeProfileAsync" ProfileDeleted="ResetProfileAsync" @ref="_profilePicker" />
                }

                @* «?» — что это за страница (D8). Последней: она ничего не выбирает. *@
                <AboutPicker Transliterate="TransliterateExample" OpenFeedback="OpenFeedbackAsync" />
            </aside>
        }

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        else if (_result.Length > 0)
        {
            @* Карточка вывода (D17). Шапка липнет к верху экрана, пока карточка
               прокручивается: у суры кнопка копирования видна у любого аята. Метки
               рядом с подписью — чем записан вывод; нажатие открывает свою панель.
               Кнопка копирует _result целиком: строки ниже — только вёрстка. *@
            <section class="result" aria-labelledby="result-title">
                <div class="result-head">
                    <h2 id="result-title" class="result-title">@L["Result.Title"]</h2>

                    @* Метки и подпись «Вывод не изменился» (D19) делят одно место в шапке:
                       с 64rem, где панель стоит рядом с выводом, подпись на время сменяет
                       метки — шапка не растёт, строки вывода не сдвигаются. Уже 64rem
                       подпись стоит в шапке панели, а здесь скрыта. *@
                    <div class="result-meta @(_unchangedNote ? "has-note" : null)">
                    <div class="result-chips">
                        @if (_catalog is not null)
                        {
                            <button type="button" class="result-chip" title="@L["Result.ReadingChipTitle"]"
                                    aria-label="@L["Result.ReadingChip", ReadingName]" @onclick="OpenReadingAsync"><span class="result-chip-text">@ReadingName</span></button>
                        }
                        @if (_profile is not null)
                        {
                            <button type="button" class="result-chip" title="@L["Result.ProfileChipTitle"]"
                                    aria-label="@L["Result.ProfileChip", _profile.Name]" @onclick="OpenProfileAsync"><span class="result-chip-text">@_profile.Name</span></button>
                        }
                    </div>
                    <p class="result-note" role="status">@(_unchangedNote ? L["Output.Unchanged"].Value : null)</p>
                    </div>

                    @* «С арабским» (D18): над каждой строкой вывода — её арабская строка
                       поля. Тумблер — aria-pressed; на телефоне видна только иконка, подпись
                       остаётся имени кнопки. *@
                    <button type="button" class="arabic-toggle" aria-pressed="@(_arabicLines ? "true" : "false")"
                            title="@L["Result.ArabicTitle"]" @onclick="ToggleArabicLinesAsync">
                        <svg class="arabic-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 6H10M20 10h-6" /><path d="M4 15h16M4 19h11" />
                        </svg>
                        <span class="arabic-toggle-label">@L["Result.Arabic"]</span>
                    </button>

                    @* Значок и подпись — одни и те же узлы во всех состояниях: галочка
                       дорисовывается поверх листов, а живая область объявляет новую
                       подпись, а не появление новой кнопки. *@
                    <button type="button" class="copy-button @CopyClass" @onclick="CopyAsync">
                        <svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <g class="copy-icon-sheets"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></g>
                            <path class="copy-icon-check" pathLength="1" d="M5 12.5l4.5 4.5L19 7.5" />
                        </svg>
                        <span class="copy-label" aria-live="polite">@CopyLabel</span>
                    </button>
                </div>

                @* Аят на строке, номер — круглым знаком, как в мусхафе. Пробел перед
                   номером остаётся в тексте строки, а знак держит саму цифру: выделенное
                   мышью копируется тем же текстом, что и кнопкой. Знак держится вместе
                   с последним словом, у слова через дефис — с его последней частью (ayah-tail), и не переносится на строку один.
                   Изменённые сменой настройки слова — в mark (D19); новый ключ при каждой
                   смене пересоздаёт строки, и подсветка проигрывается заново.
                   Над строкой — её арабская строка поля (D18), свёрнутая, пока тумблер
                   выключен: включение раскрывает её плавно (.fold, D21). Строке без пары в
                   поле арабской строки нет. Копирование кнопкой — только _result, а
                   мышью арабское не выделяется (user-select: none). *@
                <div class="result-text" @key="_changeKey">
                    @{ var lines = ResultLine.Split(_result); var sources = ResultLine.Sources(_arabic, lines.Count); }
                    @for (var i = 0; i < lines.Count; i++)
                    {
                        var line = lines[i];
                        if (sources[i] is { } source)
                        {
                            <div class="fold result-source @(_arabicLines ? "is-open" : null)" inert="@(!_arabicLines)"><div class="fold-inner"><p class="result-source-text" dir="rtl" lang="ar">@source</p></div></div>
                        }
                        if (line.Ayah is null)
                        {
                            <div class="result-line"><ChangedText Segments="Part(i, 0, line.Text)" /></div>
                        }
                        else
                        {
                            <div class="result-line"><ChangedText Segments="Part(i, 0, line.Lead)" /><span class="ayah-tail"><ChangedText Segments="Part(i, line.Lead.Length, line.Word)" />@(line.Gap)<span class="ayah-mark">@line.Ayah</span></span></div>
                        }
                    }
                </div>
            </section>
        }
    </main>

    <footer class="footer">
        <span>@L["Footer.Tagline"]</span>
        <span aria-hidden="true">·</span>
        <a href="@FeedbackLink.RepositoryUrl" target="_blank" rel="noopener">GitHub</a>
        <span aria-hidden="true">·</span>
        <span class="footer-version" title="@BuildVersion">v@(ShortVersion)</span>
        <FeedbackButton Arabic="@_arabic" Transliteration="@_result" @ref="_feedback" />
    </footer>

    @* Отмена очистки (D20): крестик стирал текст без возврата. Плашка внизу по центру
       держится несколько секунд; живая область в разметке всегда — иначе диктор
       не заметил бы появления плашки. Между краями она уже, чем до значка отзыва
       в правом нижнем углу, и не наезжает на него. *@
    @* «Вывод обновлён» (D25): вывод меняется на каждую правку, и диктору об этом
       говорится одной фразой через секунду после последней, а не на каждый символ.
       Сам вывод не зачитывается — его читают, дойдя до карточки. Своя живая
       область: «не изменился» (D19), копирование и плашка говорят о другом. *@
    <p class="visually-hidden" role="status">@_outputNote</p>

    <div class="toast-region" role="status" aria-live="polite">
        @if (_cleared is not null)
        {
            <div class="toast @(_toastClosing ? "is-closing" : null)" inert="@_toastClosing">
                <span class="toast-text">@L["Toast.Cleared"]</span>
                <button type="button" class="toast-action" aria-label="@L["Toast.UndoLabel"]" @onclick="UndoClearAsync">@L["Toast.Undo"]</button>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Версия сборки: номер из Directory.Build.props (его ведёт release-please) и после «+»
    /// коммит. В подвале — номер и семь знаков коммита, полностью — во всплывающей подсказке.
    /// </summary>
    private static readonly string BuildVersion =
        typeof(App).Assembly
            .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
            .OfType<System.Reflection.AssemblyInformationalVersionAttribute>()
            .FirstOrDefault()?.InformationalVersion ?? "unknown";

    private static string ShortVersion =>
        BuildVersion.IndexOf('+') is var plus and >= 0 && BuildVersion.Length > plus + 8
            ? BuildVersion[..(plus + 8)]
            : BuildVersion;

    /// <summary>
    /// Профиль, которым страница пишет, пока человек не выбрал другой (E4): у каждого
    /// языка свой — с английским интерфейсом латиница (D7). Сохранённый выбор важнее:
    /// кто выбрал Cyrillic и переключил язык, тот остаётся на Cyrillic.
    /// </summary>
    private static string DefaultProfile => PageLanguages.Current.DefaultProfile;

    /// <summary>Ключ хранилища браузера с именем выбранного профиля (E4).</summary>
    private const string ProfileKey = "transliterator.profile";

    /// <summary>Первый аят Аль-Фатихи — на случай, если корпус не прочитался.</summary>
    private const string FallbackPlaceholder = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ";

    /// <summary>
    /// Фразы подсказки — ресурсы <c>Hint.1</c>, <c>Hint.2</c>… по порядку (D7).
    /// Короткие, чтобы на телефоне помещаться в две строки и успевать прочитаться
    /// за паузу: подсказка — не инструкция, а первое знакомство со страницей.
    /// Пример с арабским текстом — обещание: вставив его, человек получит ровно
    /// показанное профилем языка по умолчанию, и это проверяет <c>PageHintTests</c>.
    /// </summary>
    private string[] Hints() =>
        L.GetAllStrings(includeParentCultures: true)
         .Where(s => s.Name.StartsWith(HintPrefix, StringComparison.Ordinal))
         .OrderBy(s => int.Parse(s.Name[HintPrefix.Length..], System.Globalization.CultureInfo.InvariantCulture))
         .Select(s => s.Value)
         .ToArray();

    private const string HintPrefix = "Hint.";

    private enum CopyState { Idle, Copied, Failed }

    /// <summary>Ключ хранилища браузера, под которым живёт выбранная ступень чтения (I2).</summary>
    private const string ReadingKey = "transliterator.reading";

    /// <summary>Ключ хранилища браузера для тумблера «С арабским» (D18).</summary>
    private const string ArabicLinesKey = "transliterator.arabicLines";

    /// <summary>Показывать ли над строками вывода их арабские строки (D18).</summary>
    private bool _arabicLines;

    private IReadOnlyList<CorpusSurah> _surahs = Array.Empty<CorpusSurah>();
    private TransliterationProfile? _profile;
    private TajweedRuleCatalog? _catalog;
    private ReadingChoice _reading = ReadingChoice.Default;
    private string _placeholder = FallbackPlaceholder;
    private string _arabic = string.Empty;
    private string _result = string.Empty;
    private string? _error;

    // Подсветка изменённого (D19): что изменила последняя смена настройки, ключ
    // строк вывода (новый — подсветка проигрывается заново) и подпись «не изменился».
    private OutputDiff? _changes;
    private int _changeKey;
    private bool _unchangedNote;
    private int _unchangedStamp;

    /// <summary>
    /// Сколько повтор вывода в панели держится на строке первого изменения (D19).
    /// Вспышка слов короче (--motion-highlight в app.css) и гаснет сама; по этому
    /// сроку снимаются отметки, и повтор снова начинается с начала текста.
    /// </summary>
    private static readonly TimeSpan PreviewHoldDuration = TimeSpan.FromSeconds(3);

    /// <summary>Сколько держится подпись «Вывод не изменился» (D19).</summary>
    private static readonly TimeSpan UnchangedNoteDuration = TimeSpan.FromSeconds(3);

    // Объявление «Вывод обновлён» (D25): пауза после последней правки, срок фразы
    // в живой области, её текст и вывод, о котором уже сказано.
    private static readonly TimeSpan OutputNoteDelay = TimeSpan.FromSeconds(1);
    private static readonly TimeSpan OutputNoteDuration = TimeSpan.FromSeconds(3);
    private string? _outputNote;
    private int _outputNoteStamp;
    private string _announcedResult = string.Empty;

    private ElementReference _hint;
    private ElementReference _input;
    private ElementReference _composerBar;
    private bool _resizePending;
    private bool _hintPaused;

    // Вставка и отмена очистки (D20): умеет ли браузер читать буфер, строка о неудаче
    // вставки, очищенный текст для «Вернуть» и метки последних таймеров.
    private bool _canPaste;
    private string? _pasteNote;
    private int _pasteStamp;
    private string? _cleared;
    private bool _toastClosing;
    private int _toastStamp;

    /// <summary>Суры быстрого старта (D24); которых нет в корпусе — пропускаются.</summary>
    private static readonly int[] QuickSurahNumbers = { 1, 112, 114 };

    private IReadOnlyList<CorpusSurah> _quickSurahs = Array.Empty<CorpusSurah>();
    private CopyState _copyState;
    private int _copyStamp;

    private bool HasText => !string.IsNullOrWhiteSpace(_arabic);

    /// <summary>
    /// Сура, выбранная последней, и её текст (D15): пока поле держит именно его,
    /// сура отмечена в списке; поле правили — отметки нет.
    /// </summary>
    private int? _chosenSurah;
    private string? _chosenText;

    private int? CurrentSurah => _arabic == _chosenText ? _chosenSurah : null;

    /// <summary>
    /// Открытая панель на широком экране отодвигает поле и вывод (D6) — кроме
    /// списка сур: он выпадает под своей кнопкой и места не просит (D15). Для
    /// этого странице нужно знать, какая панель открыта. Уже 64rem панель — нижний
    /// лист (D14), и пока он открыт, страница под ним не прокручивается.
    /// </summary>
    private void OnPanelsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
        _ = JS.InvokeVoidAsync("page.sheetOpen", Panels.Current is not null).AsTask();
    }

    public void Dispose() => Panels.Changed -= OnPanelsChanged;

    protected override async Task OnInitializedAsync()
    {
        Panels.Changed += OnPanelsChanged;

        _surahs = await LoadSurahsAsync();
        _quickSurahs = QuickSurahNumbers.Select(n => _surahs.FirstOrDefault(s => s.Number == n)).OfType<CorpusSurah>().ToList();
        _placeholder = _surahs.FirstOrDefault(s => s.Number == 1)?.Ayahs.FirstOrDefault()?.Arabic ?? FallbackPlaceholder;

        _profile = await Profiles.GetProfileAsync(DefaultProfile);
        if (_profile is null)
            _error = L["Error.ProfileNotLoaded", DefaultProfile];

        _catalog = LoadCatalog();
    }

    /// <summary>
    /// Каталог, как и корпус, — ресурс сборки, и битый ресурс не пройдёт тесты.
    /// Но не прочитался — страница остаётся рабочей: без выбора чтения, полным таджвидом.
    /// </summary>
    private TajweedRuleCatalog? LoadCatalog()
    {
        try
        {
            return EmbeddedTajweedRuleCatalog.Catalog;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Tajweed rule catalog could not be read");
            return null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Подсказка и высота поля — удобство, а не работа страницы: не загрузился
        // скрипт — поле остаётся полем, и транслитерация работает.
        try
        {
            if (firstRender)
            {
                await JS.InvokeVoidAsync("page.setDocument", PageLanguages.Current.Code,
                                         L["Page.Title"].Value, L["Page.Description"].Value);
                await RestoreDraftAsync();
                await JS.InvokeVoidAsync("page.typewriter", _hint, Hints(), _input);
                _hintPaused = false;
                await JS.InvokeVoidAsync("page.autosize", _input);
                await JS.InvokeVoidAsync("page.fitBar", _composerBar);
                _canPaste = await JS.InvokeAsync<bool>("page.canPaste");
                if (_canPaste)
                    StateHasChanged();
                await RestoreReadingAsync();
                await RestoreArabicLinesAsync();
                await RestoreProfileAsync();
            }

            // Подсказка стоит, пока в поле есть текст (D16). Значение поля Blazor меняет
            // и сам (выбор суры, очистка) — событие input тогда не приходит, поэтому
            // состояние ведётся отсюда, а не слушателем в скрипте.
            if (HasText != _hintPaused)
            {
                _hintPaused = HasText;
                await JS.InvokeVoidAsync("page.hintPaused", _hint, _hintPaused);
            }

            if (_resizePending)
            {
                _resizePending = false;
                await JS.InvokeVoidAsync("page.resize", _input);
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Page script is unavailable");
        }
    }

    /// <summary>
    /// Битый корпус — сломанная сборка, и тесты её не пропустят. Но если он всё же
    /// доехал, страница остаётся рабочей без готовых сур: ввести текст руками можно
    /// и без них.
    /// </summary>
    private async Task<IReadOnlyList<CorpusSurah>> LoadSurahsAsync()
    {
        try
        {
            return await Corpus.GetAllSurahsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Corpus could not be read");
            return Array.Empty<CorpusSurah>();
        }
    }

    /// <summary>
    /// Выбор чтения помнится в браузере. Читается после первой отрисовки — до неё
    /// скрипта страницы может ещё не быть. Сверяется с каталогом: из хранилища
    /// приходит то, что сохранила прежняя версия страницы.
    /// </summary>
    private async Task RestoreReadingAsync()
    {
        if (_catalog is null)
            return;

        var stored = await JS.InvokeAsync<string?>("page.load", ReadingKey);
        var reading = ReadingChoice.Parse(stored, _catalog);

        if (reading.Serialize() == _reading.Serialize())
            return;

        _reading = reading;
        Calculate();
        StateHasChanged();
    }

    /// <summary>
    /// Тумблер «С арабским» помнится в браузере (D18) и, как ступень чтения,
    /// читается после первой отрисовки.
    /// </summary>
    private async Task RestoreArabicLinesAsync()
    {
        if (await JS.InvokeAsync<string?>("page.load", ArabicLinesKey) != "1" || _arabicLines)
            return;

        _arabicLines = true;
        StateHasChanged();
    }

    private async Task ToggleArabicLinesAsync()
    {
        _arabicLines = !_arabicLines;

        try
        {
            await JS.InvokeVoidAsync("page.save", ArabicLinesKey, _arabicLines ? "1" : string.Empty);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Arabic lines choice could not be saved");
        }
    }

    /// <summary>
    /// Текст поля, отложенный сменой языка (D7): страница перезагрузилась, а текст
    /// и его транслитерация на месте.
    /// </summary>
    private async Task RestoreDraftAsync()
    {
        if (await PageCulture.TakeDraftAsync(JS) is not { Length: > 0 } draft)
            return;

        _arabic = draft;
        _resizePending = true;
        Calculate();
        StateHasChanged();
    }

    /// <summary>Выбор языка запоминается, и страница загружается заново на нём.</summary>
    private async Task ChangeLanguageAsync(PageLanguage language)
    {
        try
        {
            await PageCulture.SwitchAsync(JS, language, _arabic);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Language could not be switched");
        }
    }

    /// <summary>
    /// Выбранный профиль помнится по имени. Нет такого больше — удалён в другой
    /// вкладке, хранилище очищено — страница остаётся на профиле по умолчанию.
    /// Имя, сохранённое прежней версией страницы, переписывается на нынешнее (E8):
    /// <c>Standard</c> — это <c>Cyrillic</c>, а свой профиль, чьё имя занял
    /// встроенный, переехал под имя копии, и выбор переезжает вместе с ним.
    /// </summary>
    private async Task RestoreProfileAsync()
    {
        var stored = await JS.InvokeAsync<string?>("page.load", ProfileKey);
        if (string.IsNullOrEmpty(stored))
            return;

        try
        {
            var moved = await Profiles.MoveShadowedAsync();
            var name = moved.TryGetValue(stored, out var renamed) ? renamed
                     : await Profiles.ProfileExistsAsync(stored) ? stored
                     : ProfileNames.Current(stored);

            if (name != stored)
                await JS.InvokeVoidAsync("page.save", ProfileKey, name);

            if (name == _profile?.Name || await Profiles.GetProfileAsync(name) is not { } profile)
                return;

            _profile = profile;
            Calculate();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Stored profile could not be read");
        }
    }

    /// <summary>
    /// Свой профиль удалён — страница возвращается к профилю языка по умолчанию,
    /// и выбор забывается: это не выбор человека, и при смене языка профиль
    /// по умолчанию снова сменится вместе с ним.
    /// </summary>
    private async Task ResetProfileAsync()
    {
        if (await Profiles.GetProfileAsync(DefaultProfile) is not { } profile)
            return;

        _profile = profile;
        RecalculateSetting();

        try
        {
            await JS.InvokeVoidAsync("page.save", ProfileKey, string.Empty);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Profile choice could not be reset");
        }
    }

    private async Task ChangeProfileAsync(TransliterationProfile profile)
    {
        // Копия и переименование приходят тем же путём, но графем не меняют —
        // это не смена настройки вывода, и подписи «не изменился» у них нет. Правка
        // графемы приходит тем же объектом, что уже выбран.
        var sameRules = _profile is not null && !ReferenceEquals(profile, _profile)
                        && profile.Rules.Count == _profile.Rules.Count
                        && profile.Rules.All(r => _profile.Rules.TryGetValue(r.Key, out var v) && v == r.Value);

        _profile = profile;
        if (sameRules)
            Calculate();
        else
            RecalculateSetting();

        try
        {
            await JS.InvokeVoidAsync("page.save", ProfileKey, profile.Name);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Profile choice could not be saved");
        }
    }

    private async Task ChangeReadingAsync(ReadingChoice reading)
    {
        _reading = reading;
        RecalculateSetting();

        try
        {
            await JS.InvokeVoidAsync("page.save", ReadingKey, reading.Serialize());
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Reading choice could not be saved");
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _arabic = e.Value?.ToString() ?? string.Empty;
        Calculate();
        AnnounceOutput();
        _ = HideToastAsync();
    }

    /// <summary>
    /// Сура заменяет текст в поле целиком — так же, как если бы его вставили
    /// руками, — и сразу показывает результат. Аят на строке (D3).
    /// </summary>
    private void ChooseAsync(CorpusSurah surah)
    {
        _arabic = CorpusText.Arabic(surah);
        _chosenSurah = surah.Number;
        _chosenText = _arabic;
        _resizePending = true;
        Calculate();
        AnnounceOutput();
        _ = HideToastAsync();
    }

    /// <summary>Сколько держится плашка «Поле очищено» (D20).</summary>
    private static readonly TimeSpan ToastDuration = TimeSpan.FromSeconds(5);

    /// <summary>Сколько держится строка «буфер не прочитан» (D20).</summary>
    private static readonly TimeSpan PasteNoteDuration = TimeSpan.FromSeconds(4);

    /// <summary>
    /// Очистка запоминает текст, и плашка предлагает его вернуть (D20). Повторная
    /// очистка начинает срок заново: гасит плашку только последний таймер.
    /// </summary>
    private async Task ClearAsync()
    {
        _cleared = _arabic;
        _toastClosing = false;
        var stamp = ++_toastStamp;

        _arabic = string.Empty;
        _resizePending = true;
        Calculate();

        await _input.FocusAsync();
        await Task.Delay(ToastDuration);

        if (stamp == _toastStamp)
            await HideToastAsync();
    }

    /// <summary>«Вернуть» — тот же текст и сразу вывод; курсор снова в поле.</summary>
    private async Task UndoClearAsync()
    {
        if (_cleared is null)
            return;

        _arabic = _cleared;
        _resizePending = true;
        Calculate();
        AnnounceOutput();
        _ = HideToastAsync();

        await _input.FocusAsync();
    }

    /// <summary>
    /// Плашка уходит с анимацией — столько же, сколько уходящая панель (PanelClosing),
    /// потом исчезает из разметки. Новая очистка за это время уход отменяет.
    /// </summary>
    private async Task HideToastAsync()
    {
        if (_cleared is null || _toastClosing)
            return;

        var stamp = ++_toastStamp;
        _toastClosing = true;
        StateHasChanged();
        await Task.Delay(PanelClosing.Duration);

        if (stamp != _toastStamp)
            return;

        _cleared = null;
        _toastClosing = false;
        StateHasChanged();
    }

    /// <summary>
    /// «Вставить» (D20): текст буфера заменяет пустое поле, как вставка руками, и сразу
    /// считается. Буфер не прочитан или пуст — строка рядом с кнопкой, и она гаснет сама.
    /// </summary>
    private async Task PasteAsync()
    {
        string? text = null;

        try
        {
            text = await JS.InvokeAsync<string?>("page.paste");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Clipboard could not be read");
        }

        if (!string.IsNullOrWhiteSpace(text))
        {
            _pasteNote = null;
            _arabic = text;
            _resizePending = true;
            Calculate();
            AnnounceOutput();
            _ = HideToastAsync();
            await _input.FocusAsync();
            return;
        }

        _pasteNote = text is null ? L["Composer.PasteFailed"] : L["Composer.PasteEmpty"];
        var stamp = ++_pasteStamp;
        StateHasChanged();
        await Task.Delay(PasteNoteDuration);

        if (stamp == _pasteStamp)
            _pasteNote = null;
    }

    private async Task CopyAsync()
    {
        var copied = false;

        try
        {
            copied = await JS.InvokeAsync<bool>("page.copy", _result);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Clipboard is unavailable");
        }

        _copyState = copied ? CopyState.Copied : CopyState.Failed;

        // Отметка гаснет сама. Второе нажатие раньше срока продлевает её, а не
        // гасит на полпути: гасит только последнее.
        var stamp = ++_copyStamp;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2));

        if (stamp == _copyStamp)
            _copyState = CopyState.Idle;
    }

    private string CopyLabel => _copyState switch
    {
        CopyState.Copied => L["Copy.Done"],
        CopyState.Failed => L["Copy.Failed"],
        _ => L["Copy.Action"],
    };

    private string? CopyClass => _copyState switch
    {
        CopyState.Copied => "is-copied",
        CopyState.Failed => "is-failed",
        _ => null,
    };

    private ReadingPicker? _readingPicker;
    private ProfilePicker? _profilePicker;

    /// <summary>Метка ступени над выводом (D17) — имя той же ступени, что у кнопки сбоку.</summary>
    private string ReadingName => ReadingPicker.ModeName(L, _reading.Mode);

    /// <summary>Метки над выводом (D17) открывают ту же панель, что и кнопка сбоку.</summary>
    private Task OpenReadingAsync() => _readingPicker?.OpenAsync() ?? Task.CompletedTask;

    private Task OpenProfileAsync() => _profilePicker?.OpenAsync() ?? Task.CompletedTask;

    private FeedbackButton? _feedback;

    /// <summary>Кнопка отзыва из «О приложении» (D8) открывает ту же форму, что и в подвале.</summary>
    private Task OpenFeedbackAsync() => _feedback?.OpenAsync() ?? Task.CompletedTask;

    /// <summary>
    /// Пример правила в «Неполном таджвиде» (I3) и пример «О приложении» (D8) — тем же профилем и выбором, что
    /// и вывод страницы. Сбой примера страницу не роняет: показывается пример каталога.
    /// </summary>
    private string? TransliterateExample(string arabic)
    {
        if (_profile is null)
            return null;

        try
        {
            return Transliteration.Transliterate(arabic, _profile, _reading.ToOptions()).TransliteratedText;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Example transliteration failed");
            return null;
        }
    }

    /// <summary>
    /// Пересчёт на каждую правку, без кнопки. Профиль загружен заранее, и путь
    /// «текст + профиль» (C2) синхронный: ответ на прежний ввод не может прийти
    /// после ответа на новый и затереть его.
    /// </summary>
    private void Calculate()
    {
        if (_profile is null)
            return;

        _copyState = CopyState.Idle;
        _changes = null;
        _unchangedNote = false;

        try
        {
            _result = Transliteration.Transliterate(_arabic, _profile, _reading.ToOptions()).TransliteratedText;
            _error = null;
        }
        catch (Exception ex)
        {
            // Ловится всё, а не только TransliterationException: текст вставляют
            // откуда придётся, и необработанное исключение в WebAssembly гасит
            // страницу целиком — до перезагрузки она больше не отвечает.
            Logger.LogError(ex, "Transliteration failed");
            _result = string.Empty;
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Пересчёт после смены настройки (D19): ступени, правила, счёта, профиля или
    /// его графемы. Изменившиеся слова подсвечиваются; не изменилось ничего — на
    /// несколько секунд подпись, почему настройка не видна. Набор текста, сура и
    /// восстановление из хранилища идут через Calculate — без подсветки.
    /// </summary>
    private void RecalculateSetting()
    {
        var before = _error is null ? _result : string.Empty;
        Calculate();

        if (_error is not null || before.Length == 0 || _result.Length == 0)
            return;

        var diff = OutputDiff.Compare(before, _result);
        if (diff.HasChanges)
        {
            _changes = diff;
            _ = ExpireChangesAsync(++_changeKey);
            AnnounceOutput();
        }
        else if (before == _result)
        {
            _ = ShowUnchangedNoteAsync();
        }
    }

    /// <summary>
    /// Срок повтора с места изменения вышел — отметки снимаются, если новой смены
    /// за это время не было: новая смена меняет ключ и начинает срок заново.
    /// </summary>
    private async Task ExpireChangesAsync(int key)
    {
        await Task.Delay(PreviewHoldDuration);

        if (key != _changeKey || _changes is null)
            return;

        _changes = null;
        StateHasChanged();
    }

    /// <summary>Подпись «не изменился» гаснет сама; новая смена начинает срок заново.</summary>
    private async Task ShowUnchangedNoteAsync()
    {
        _unchangedNote = true;
        var stamp = ++_unchangedStamp;
        await Task.Delay(UnchangedNoteDuration);

        if (stamp != _unchangedStamp)
            return;

        _unchangedNote = false;
        StateHasChanged();
    }

    /// <summary>
    /// Объявление «Вывод обновлён» (D25) откладывается: каждая новая правка сбрасывает
    /// срок, и фраза звучит раз — через <see cref="OutputNoteDelay"/> после последней.
    /// Пустая область между объявлениями нужна, чтобы диктор прочитал ту же фразу снова.
    /// </summary>
    private void AnnounceOutput()
    {
        _outputNote = null;
        _ = ShowOutputNoteAsync(++_outputNoteStamp);
    }

    private async Task ShowOutputNoteAsync(int stamp)
    {
        await Task.Delay(OutputNoteDelay);

        // Ошибку объявляет role="alert", очистку — плашка; вывод, вернувшийся к
        // прежнему (набрали и стёрли), не обновился.
        if (stamp != _outputNoteStamp || _error is not null || _result.Length == 0 || _result == _announcedResult)
            return;

        _announcedResult = _result;
        _outputNote = L["Output.Updated"];
        StateHasChanged();
        await Task.Delay(OutputNoteDuration);

        if (stamp != _outputNoteStamp)
            return;

        _outputNote = null;
        StateHasChanged();
    }

    /// <summary>Кусок строки вывода по отрезкам подсветки; без неё — одним отрезком.</summary>
    private IReadOnlyList<DiffSegment> Part(int line, int start, string text) =>
        ChangedText.Of(_changes, _result, line, start, text);
}

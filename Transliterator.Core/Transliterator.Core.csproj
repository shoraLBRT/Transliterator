<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Обращение к API, недоступному в браузере, должно ломать сборку здесь,
         а не падать на старте страницы: проверку включает SupportedPlatform ниже,
         а эта строка переводит её из предупреждения в ошибку. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ядро должно собираться под браузер: веб-версия (эпик D) — Blazor
         WebAssembly. Без этой строки анализ совместимости (CA1416)
         про браузер молчит. -->
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Профили перечисляются маской, а не поимённо: хранилище читает из папки
         всё, что там лежит, и профиль, забытый в этом списке, до него не доедет. -->
    <Content Include="Resources\Profiles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- Те же файлы вшиваются в сборку. Это не копия: источник один, и разойтись
         файлу рядом со сборкой и ресурсом внутри неё физически негде.
         В браузере каталога рядом со сборкой нет вовсе — там профили читаются
         только отсюда (EmbeddedProfileRepository). -->
    <EmbeddedResource Include="Resources\Profiles\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Корпус примеров — такой же ресурс ядра, как и профили: тесты и веб-версия
         читают один файл, копий нет. Маска по той же причине, что у профилей. -->
    <Content Include="Resources\Corpus\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Extensions\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transliterator.Domain\Transliterator.Domain.csproj" />
  </ItemGroup>

</Project>
